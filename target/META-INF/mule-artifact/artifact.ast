,"namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ROUTER"}},"fileName":"implementation/shipment.xml","line":949,"column":3}],"location":"label-report-flow/processors/5"},"metadata":{"docAttributes":{"name":"Email Report?","id":"2646f75a-049a-44c9-baaa-e3366b241dcd"},"endColumn":12,"endLine":961,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":12},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":949},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":949},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":961},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":82},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":961}},"sourceCode":"\u003cchoice doc:name\u003d\"Email Report?\" doc:id\u003d\"2646f75a-049a-44c9-baaa-e3366b241dcd\"\u003e\r\n\u003cwhen expression\u003d\"#[p(\u0027labelSweep.reportEmail\u0027) \u003d\u003d \u0027true\u0027]\"\u003e\r\n\u003ctry doc:name\u003d\"Email\" doc:id\u003d\"6056ffc2-db39-4842-b74f-eec536ebfcb7\"\u003e\r\n\u003cflow-ref doc:name\u003d\"label-report-email-flow\" doc:id\u003d\"55e337be-9cb4-4f78-9ba6-325f7839a858\" name\u003d\"label-report-email-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Emailed\" doc:id\u003d\"de4764d8-eb68-48e4-9941-2020ce4b8cbf\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL REPORT\", \"messages\": \"Report emailed\", \"via\": \"graph\", \"to\": p(\"labelSweep.reportTo\")}]\"\u003e\u003c/logger\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"true\" logException\u003d\"false\" doc:name\u003d\"Email Failed\" doc:id\u003d\"140a39b9-6b0e-42f1-83e7-437d6b869b54\"\u003e\r\n\u003clogger level\u003d\"WARN\" doc:name\u003d\"Log Email Failed\" doc:id\u003d\"40ce5850-9fbf-4a50-a277-4e89cf653428\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL REPORT\", \"messages\": \"Report email failed\", \"step\": vars.emailStep default null, \"errorType\": (error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\"), \"httpStatus\": error.errorMessage.attributes.statusCode default null}]\"\u003e\u003c/logger\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e","startColumn":3,"startLine":949},"parameters":[{"groupModelName":"Business Events","modelName":"enableDefaultEvents","value":{"aBoolean":false},"defaultValue":true},{"groupModelName":"Output","modelName":"target","value":{},"defaultValue":true},{"groupModelName":"Output","modelName":"targetValue","value":{"expression":"payload"},"defaultValue":true},{"groupModelName":"Error Mappings","modelName":"errorMappings","value":{},"defaultValue":true}],"extensionModel":{"name":"mule"},"modelName":"choice","modelType":"OPERATION","annotations":{"{http://www.mulesoft.org/schema/mule/documentation}name":"Email Report?","{http://www.mulesoft.org/schema/mule/documentation}id":"2646f75a-049a-44c9-baaa-e3366b241dcd"}}],"componentType":"SUB_FLOW","identifier":{"name":"sub-flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"location":{"name":"label-report-flow","parts":[{"partPath":"label-report-flow","partIdentifier":{"identifier":{"name":"sub-flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"SUB_FLOW"}},"fileName":"implementation/shipment.xml","line":842,"column":2}],"location":"label-report-flow"},"metadata":{"docAttributes":{"id":"8817c489-6c0c-46a8-a951-b636555459f8"},"endColumn":13,"endLine":962,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":13},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":842},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":842},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":962},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":83},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":962}},"sourceCode":"\u003csub-flow name\u003d\"label-report-flow\" doc:id\u003d\"8817c489-6c0c-46a8-a951-b636555459f8\"\u003e\r\n\u003cdb:select doc:name\u003d\"Label Counts\" doc:id\u003d\"88e392d2-bca2-47cf-8f14-19d2f8ef24f9\" config-ref\u003d\"Database_Config\" target\u003d\"reportCounts\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelReportCounts}]]\u003e\u003c/db:sql\u003e\r\n\u003c/db:select\u003e\r\n\u003cdb:select doc:name\u003d\"Labels Not Delivered\" doc:id\u003d\"9647ada8-5c7d-4491-82e9-25fdd1b2b27a\" config-ref\u003d\"Database_Config\" target\u003d\"reportOpen\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelReportOpen}]]\u003e\u003c/db:sql\u003e\r\n\u003c/db:select\u003e\r\n\u003cee:transform doc:name\u003d\"Report Summary\" doc:id\u003d\"107a87eb-dba1-4ef8-99ac-4aceadca65c9\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"labelReport\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n// r16: partners left out of the report (PROD: BND, our test tenant, whose test labels go to the test endpoint)\nvar hide \u003d ((p(\u0027labelSweep.reportHidePartners\u0027) default \"\") splitBy \",\") map trim($) filter ($ !\u003d \"\")\nvar rows \u003d (vars.reportCounts default []) filter !(hide contains ($.provider_code as String))\nfun total(list) \u003d sum(list map (($.n default 0) as Number)) default 0\nvar codes \u003d ((rows filter ($.provider_code !\u003d \"-\")) map ($.provider_code as String)) distinctBy $ orderBy $\nvar partners \u003d codes map ((code) -\u003e do {\n\tvar mine \u003d rows filter ($.provider_code \u003d\u003d code)\n\t---\n\t{\n\t\tpartner: code,\n\t\tbyWebhook: total(mine filter (($.status \u003d\u003d \"sent\") and ($.source \u003d\u003d \"webhook\"))),\n\t\tbySweep: total(mine filter (($.status \u003d\u003d \"sent\") and ($.source !\u003d \"webhook\"))),\n\t\twouldSend: total(mine filter ($.status \u003d\u003d \"dry_run\")),\n\t\tfailing: total(mine filter ([\"failed\", \"sending\"] contains $.status)),\n\t\trejected: total(mine filter ($.status \u003d\u003d \"rejected\")),\n\t\tnoUrl: total(mine filter ($.status \u003d\u003d \"no_webhook_url\"))\n\t}\n})\n---\n{\n\tdryRun: p(\u0027labelSweep.dryRun\u0027) \u003d\u003d \u0027true\u0027,\n\tpartners: partners,\n\tbyWebhook: sum(partners map $.byWebhook) default 0,\n\tbySweep: sum(partners map $.bySweep) default 0,\n\twouldSend: sum(partners map $.wouldSend) default 0,\n\tfailing: sum(partners map $.failing) default 0,\n\trejected: sum(partners map $.rejected) default 0,\n\totherLabels: total(rows filter (($.provider_code \u003d\u003d \"-\") and ($.status \u003d\u003d \"not_partner\"))),\n\tnoFills: total(rows filter ($.status \u003d\u003d \"no_fills\")),\n\tlookupFailed: total(rows filter ($.status \u003d\u003d \"lookup_failed\")),\n\tnotDelivered: ((vars.reportOpen default []) filter !(hide contains ($.provider_code as String))) map {\n\t\tlabel: $.label_id,\n\t\tpartner: $.provider_code,\n\t\tstatus: $.status,\n\t\tattempts: $.attempts,\n\t\tsince: $.created_epoch,\n\t\terror: $.last_error\n\t}\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cee:transform doc:name\u003d\"Report Email\" doc:id\u003d\"71e9f705-25d8-4108-bb57-2c40c635ee75\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"email\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\nvar r \u003d vars.labelReport\nfun s(v) \u003d if (v \u003d\u003d null) \"\" else (v as String)\nfun esc(v) \u003d ((s(v) replace \"\u0026\" with \"\u0026amp;\") replace \"\u003c\" with \"\u0026lt;\") replace \"\u003e\" with \"\u0026gt;\"\nfun ct(epoch) \u003d if (epoch \u003d\u003d null) \"\" else ((((epoch as Number) as DateTime {unit: \"seconds\"}) \u003e\u003e \"America/Chicago\") as String {format: \"MMM d, h:mm a\"})\nvar cell \u003d \"style\u003d\u0027padding:4px 10px;border-bottom:1px solid #ddd;text-align:left\u0027\"\nfun row(values) \u003d \"\u003ctr\u003e\" ++ ((values map (\"\u003ctd \" ++ cell ++ \"\u003e\" ++ esc($) ++ \"\u003c/td\u003e\")) joinBy \"\") ++ \"\u003c/tr\u003e\"\nfun head(values) \u003d \"\u003ctr\u003e\" ++ ((values map (\"\u003cth \" ++ cell ++ \"\u003e\" ++ $ ++ \"\u003c/th\u003e\")) joinBy \"\") ++ \"\u003c/tr\u003e\"\nvar delivered \u003d r.byWebhook + r.bySweep\nvar open \u003d r.failing + r.rejected\nvar subject \u003d s(p(\u0027labelSweep.reportSubjectPrefix\u0027)) ++ \"Shipping labels, last 24 hours: \" ++ s(delivered) ++ \" delivered\"\n\t++ (if (open \u003e 0) \", \" ++ s(open) ++ \" not delivered\" else \"\")\n\t++ (if (r.dryRun) \" (sweep in dry run, \" ++ s(r.wouldSend) ++ \" it would send)\" else \"\")\nvar partnerTable \u003d if (isEmpty(r.partners)) \"\u003cp\u003eNo partner labels in the last 24 hours.\u003c/p\u003e\"\n\telse \"\u003ctable style\u003d\u0027border-collapse:collapse\u0027\u003e\"\n\t\t++ head([\"Partner\", \"Sent by DRX\u0026#39;s webhook\", \"Sent by the sweep\", (if (r.dryRun) \"Sweep would send\" else \"\"), \"Failing\", \"Rejected by partner\"] filter ($ !\u003d \"\"))\n\t\t++ ((r.partners map row([$.partner, $.byWebhook, $.bySweep] ++ (if (r.dryRun) [$.wouldSend] else []) ++ [$.failing, $.rejected])) joinBy \"\")\n\t\t++ \"\u003c/table\u003e\"\nvar openTable \u003d if (isEmpty(r.notDelivered)) \"\u003cp\u003eNothing is waiting: every partner label from the last 3 days was delivered.\u003c/p\u003e\"\n\telse \"\u003cp\u003e\u003cb\u003eNot delivered (last 3 days):\u003c/b\u003e\u003c/p\u003e\u003ctable style\u003d\u0027border-collapse:collapse\u0027\u003e\"\n\t\t++ head([\"DRX label\", \"Partner\", \"Status\", \"Tries\", \"First seen (Central)\", \"Last error\"])\n\t\t++ ((r.notDelivered map row([$.label, $.partner, $.status, $.attempts, ct($.since), $.error])) joinBy \"\")\n\t\t++ \"\u003c/table\u003e\"\nvar content \u003d \"\u003chtml\u003e\u003cbody style\u003d\u0027font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#222\u0027\u003e\"\n\t++ \"\u003cp\u003ePartner shipping labels in the last 24 hours\" ++ (if (r.dryRun) \" (the sweep is in \u003cb\u003edry run\u003c/b\u003e: it records what it would send and sends nothing)\" else \"\") ++ \":\u003c/p\u003e\"\n\t++ \"\u003cul\u003e\u003cli\u003e\u003cb\u003e\" ++ s(delivered) ++ \"\u003c/b\u003e delivered: \" ++ s(r.byWebhook) ++ \" by DRX\u0026#39;s webhook, \" ++ s(r.bySweep) ++ \" by the sweep\u003c/li\u003e\"\n\t++ (if (r.dryRun) \"\u003cli\u003e\u003cb\u003e\" ++ s(r.wouldSend) ++ \"\u003c/b\u003e the sweep would have sent (DRX\u0026#39;s webhook never fired for them)\u003c/li\u003e\" else \"\")\n\t++ \"\u003cli\u003e\u003cb\u003e\" ++ s(r.failing) ++ \"\u003c/b\u003e failing (retried every \" ++ s(p(\u0027labelSweep.retryMinutes\u0027)) ++ \" minutes), \u003cb\u003e\" ++ s(r.rejected) ++ \"\u003c/b\u003e rejected by the partner\u003c/li\u003e\"\n\t++ \"\u003cli\u003e\" ++ s(r.otherLabels) ++ \" other labels checked (not a partner order), \" ++ s(r.noFills) ++ \" with no fills, \" ++ s(r.lookupFailed) ++ \" that could not be read from DRX\u003c/li\u003e\u003c/ul\u003e\"\n\t++ partnerTable ++ openTable\n\t++ \"\u003cp style\u003d\u0027color:#666;font-size:12px\u0027\u003eFrom the MuleSoft provider API label sweep. Counts and DRX label ids only.\u003c/p\u003e\u003c/body\u003e\u003c/html\u003e\"\n---\n{\n\tmessage: {\n\t\tsubject: subject,\n\t\tbody: {\n\t\t\tcontentType: \"HTML\",\n\t\t\tcontent: content\n\t\t},\n\t\ttoRecipients: (s(p(\u0027labelSweep.reportTo\u0027)) splitBy \",\") map {\n\t\t\temailAddress: {\n\t\t\t\taddress: trim($)\n\t\t\t}\n\t\t}\n\t},\n\tsaveToSentItems: true\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Report\" doc:id\u003d\"48820653-b360-4262-b6f6-2ba334fc5f5f\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL REPORT\", \"dryRun\": vars.labelReport.dryRun, \"sentByWebhook\": vars.labelReport.byWebhook, \"sentBySweep\": vars.labelReport.bySweep, \"wouldSend\": vars.labelReport.wouldSend, \"failing\": vars.labelReport.failing, \"rejected\": vars.labelReport.rejected, \"otherLabels\": vars.labelReport.otherLabels, \"notDelivered\": vars.labelReport.notDelivered map {label: $.label, partner: $.partner, status: $.status}}]\"\u003e\u003c/logger\u003e\r\n\u003cchoice doc:name\u003d\"Email Report?\" doc:id\u003d\"2646f75a-049a-44c9-baaa-e3366b241dcd\"\u003e\r\n\u003cwhen expression\u003d\"#[p(\u0027labelSweep.reportEmail\u0027) \u003d\u003d \u0027true\u0027]\"\u003e\r\n\u003ctry doc:name\u003d\"Email\" doc:id\u003d\"6056ffc2-db39-4842-b74f-eec536ebfcb7\"\u003e\r\n\u003cflow-ref doc:name\u003d\"label-report-email-flow\" doc:id\u003d\"55e337be-9cb4-4f78-9ba6-325f7839a858\" name\u003d\"label-report-email-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Emailed\" doc:id\u003d\"de4764d8-eb68-48e4-9941-2020ce4b8cbf\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL REPORT\", \"messages\": \"Report emailed\", \"via\": \"graph\", \"to\": p(\"labelSweep.reportTo\")}]\"\u003e\u003c/logger\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"true\" logException\u003d\"false\" doc:name\u003d\"Email Failed\" doc:id\u003d\"140a39b9-6b0e-42f1-83e7-437d6b869b54\"\u003e\r\n\u003clogger level\u003d\"WARN\" doc:name\u003d\"Log Email Failed\" doc:id\u003d\"40ce5850-9fbf-4a50-a277-4e89cf653428\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL REPORT\", \"messages\": \"Report email failed\", \"step\": vars.emailStep default null, \"errorType\": (error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\"), \"httpStatus\": error.errorMessage.attributes.statusCode default null}]\"\u003e\u003c/logger\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003c/sub-flow\u003e","startColumn":2,"startLine":842},"parameters":[{"unresolvedValue":"label-report-flow","metadata":{"docAttributes":{"id":"8817c489-6c0c-46a8-a951-b636555459f8"},"endColumn":13,"endLine":962,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":13},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":842},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":842},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":962},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":83},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":962}},"sourceCode":"\u003csub-flow name\u003d\"label-report-flow\" doc:id\u003d\"8817c489-6c0c-46a8-a951-b636555459f8\"\u003e\r\n\u003cdb:select doc:name\u003d\"Label Counts\" doc:id\u003d\"88e392d2-bca2-47cf-8f14-19d2f8ef24f9\" config-ref\u003d\"Database_Config\" target\u003d\"reportCounts\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelReportCounts}]]\u003e\u003c/db:sql\u003e\r\n\u003c/db:select\u003e\r\n\u003cdb:select doc:name\u003d\"Labels Not Delivered\" doc:id\u003d\"9647ada8-5c7d-4491-82e9-25fdd1b2b27a\" config-ref\u003d\"Database_Config\" target\u003d\"reportOpen\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelReportOpen}]]\u003e\u003c/db:sql\u003e\r\n\u003c/db:select\u003e\r\n\u003cee:transform doc:name\u003d\"Report Summary\" doc:id\u003d\"107a87eb-dba1-4ef8-99ac-4aceadca65c9\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"labelReport\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n// r16: partners left out of the report (PROD: BND, our test tenant, whose test labels go to the test endpoint)\nvar hide \u003d ((p(\u0027labelSweep.reportHidePartners\u0027) default \"\") splitBy \",\") map trim($) filter ($ !\u003d \"\")\nvar rows \u003d (vars.reportCounts default []) filter !(hide contains ($.provider_code as String))\nfun total(list) \u003d sum(list map (($.n default 0) as Number)) default 0\nvar codes \u003d ((rows filter ($.provider_code !\u003d \"-\")) map ($.provider_code as String)) distinctBy $ orderBy $\nvar partners \u003d codes map ((code) -\u003e do {\n\tvar mine \u003d rows filter ($.provider_code \u003d\u003d code)\n\t---\n\t{\n\t\tpartner: code,\n\t\tbyWebhook: total(mine filter (($.status \u003d\u003d \"sent\") and ($.source \u003d\u003d \"webhook\"))),\n\t\tbySweep: total(mine filter (($.status \u003d\u003d \"sent\") and ($.source !\u003d \"webhook\"))),\n\t\twouldSend: total(mine filter ($.status \u003d\u003d \"dry_run\")),\n\t\tfailing: total(mine filter ([\"failed\", \"sending\"] contains $.status)),\n\t\trejected: total(mine filter ($.status \u003d\u003d \"rejected\")),\n\t\tnoUrl: total(mine filter ($.status \u003d\u003d \"no_webhook_url\"))\n\t}\n})\n---\n{\n\tdryRun: p(\u0027labelSweep.dryRun\u0027) \u003d\u003d \u0027true\u0027,\n\tpartners: partners,\n\tbyWebhook: sum(partners map $.byWebhook) default 0,\n\tbySweep: sum(partners map $.bySweep) default 0,\n\twouldSend: sum(partners map $.wouldSend) default 0,\n\tfailing: sum(partners map $.failing) default 0,\n\trejected: sum(partners map $.rejected) default 0,\n\totherLabels: total(rows filter (($.provider_code \u003d\u003d \"-\") and ($.status \u003d\u003d \"not_partner\"))),\n\tnoFills: total(rows filter ($.status \u003d\u003d \"no_fills\")),\n\tlookupFailed: total(rows filter ($.status \u003d\u003d \"lookup_failed\")),\n\tnotDelivered: ((vars.reportOpen default []) filter !(hide contains ($.provider_code as String))) map {\n\t\tlabel: $.label_id,\n\t\tpartner: $.provider_code,\n\t\tstatus: $.status,\n\t\tattempts: $.attempts,\n\t\tsince: $.created_epoch,\n\t\terror: $.last_error\n\t}\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cee:transform doc:name\u003d\"Report Email\" doc:id\u003d\"71e9f705-25d8-4108-bb57-2c40c635ee75\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"email\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\nvar r \u003d vars.labelReport\nfun s(v) \u003d if (v \u003d\u003d null) \"\" else (v as String)\nfun esc(v) \u003d ((s(v) replace \"\u0026\" with \"\u0026amp;\") replace \"\u003c\" with \"\u0026lt;\") replace \"\u003e\" with \"\u0026gt;\"\nfun ct(epoch) \u003d if (epoch \u003d\u003d null) \"\" else ((((epoch as Number) as DateTime {unit: \"seconds\"}) \u003e\u003e \"America/Chicago\") as String {format: \"MMM d, h:mm a\"})\nvar cell \u003d \"style\u003d\u0027padding:4px 10px;border-bottom:1px solid #ddd;text-align:left\u0027\"\nfun row(values) \u003d \"\u003ctr\u003e\" ++ ((values map (\"\u003ctd \" ++ cell ++ \"\u003e\" ++ esc($) ++ \"\u003c/td\u003e\")) joinBy \"\") ++ \"\u003c/tr\u003e\"\nfun head(values) \u003d \"\u003ctr\u003e\" ++ ((values map (\"\u003cth \" ++ cell ++ \"\u003e\" ++ $ ++ \"\u003c/th\u003e\")) joinBy \"\") ++ \"\u003c/tr\u003e\"\nvar delivered \u003d r.byWebhook + r.bySweep\nvar open \u003d r.failing + r.rejected\nvar subject \u003d s(p(\u0027labelSweep.reportSubjectPrefix\u0027)) ++ \"Shipping labels, last 24 hours: \" ++ s(delivered) ++ \" delivered\"\n\t++ (if (open \u003e 0) \", \" ++ s(open) ++ \" not delivered\" else \"\")\n\t++ (if (r.dryRun) \" (sweep in dry run, \" ++ s(r.wouldSend) ++ \" it would send)\" else \"\")\nvar partnerTable \u003d if (isEmpty(r.partners)) \"\u003cp\u003eNo partner labels in the last 24 hours.\u003c/p\u003e\"\n\telse \"\u003ctable style\u003d\u0027border-collapse:collapse\u0027\u003e\"\n\t\t++ head([\"Partner\", \"Sent by DRX\u0026#39;s webhook\", \"Sent by the sweep\", (if (r.dryRun) \"Sweep would send\" else \"\"), \"Failing\", \"Rejected by partner\"] filter ($ !\u003d \"\"))\n\t\t++ ((r.partners map row([$.partner, $.byWebhook, $.bySweep] ++ (if (r.dryRun) [$.wouldSend] else []) ++ [$.failing, $.rejected])) joinBy \"\")\n\t\t++ \"\u003c/table\u003e\"\nvar openTable \u003d if (isEmpty(r.notDelivered)) \"\u003cp\u003eNothing is waiting: every partner label from the last 3 days was delivered.\u003c/p\u003e\"\n\telse \"\u003cp\u003e\u003cb\u003eNot delivered (last 3 days):\u003c/b\u003e\u003c/p\u003e\u003ctable style\u003d\u0027border-collapse:collapse\u0027\u003e\"\n\t\t++ head([\"DRX label\", \"Partner\", \"Status\", \"Tries\", \"First seen (Central)\", \"Last error\"])\n\t\t++ ((r.notDelivered map row([$.label, $.partner, $.status, $.attempts, ct($.since), $.error])) joinBy \"\")\n\t\t++ \"\u003c/table\u003e\"\nvar content \u003d \"\u003chtml\u003e\u003cbody style\u003d\u0027font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#222\u0027\u003e\"\n\t++ \"\u003cp\u003ePartner shipping labels in the last 24 hours\" ++ (if (r.dryRun) \" (the sweep is in \u003cb\u003edry run\u003c/b\u003e: it records what it would send and sends nothing)\" else \"\") ++ \":\u003c/p\u003e\"\n\t++ \"\u003cul\u003e\u003cli\u003e\u003cb\u003e\" ++ s(delivered) ++ \"\u003c/b\u003e delivered: \" ++ s(r.byWebhook) ++ \" by DRX\u0026#39;s webhook, \" ++ s(r.bySweep) ++ \" by the sweep\u003c/li\u003e\"\n\t++ (if (r.dryRun) \"\u003cli\u003e\u003cb\u003e\" ++ s(r.wouldSend) ++ \"\u003c/b\u003e the sweep would have sent (DRX\u0026#39;s webhook never fired for them)\u003c/li\u003e\" else \"\")\n\t++ \"\u003cli\u003e\u003cb\u003e\" ++ s(r.failing) ++ \"\u003c/b\u003e failing (retried every \" ++ s(p(\u0027labelSweep.retryMinutes\u0027)) ++ \" minutes), \u003cb\u003e\" ++ s(r.rejected) ++ \"\u003c/b\u003e rejected by the partner\u003c/li\u003e\"\n\t++ \"\u003cli\u003e\" ++ s(r.otherLabels) ++ \" other labels checked (not a partner order), \" ++ s(r.noFills) ++ \" with no fills, \" ++ s(r.lookupFailed) ++ \" that could not be read from DRX\u003c/li\u003e\u003c/ul\u003e\"\n\t++ partnerTable ++ openTable\n\t++ \"\u003cp style\u003d\u0027color:#666;font-size:12px\u0027\u003eFrom the MuleSoft provider API label sweep. Counts and DRX label ids only.\u003c/p\u003e\u003c/body\u003e\u003c/html\u003e\"\n---\n{\n\tmessage: {\n\t\tsubject: subject,\n\t\tbody: {\n\t\t\tcontentType: \"HTML\",\n\t\t\tcontent: content\n\t\t},\n\t\ttoRecipients: (s(p(\u0027labelSweep.reportTo\u0027)) splitBy \",\") map {\n\t\t\temailAddress: {\n\t\t\t\taddress: trim($)\n\t\t\t}\n\t\t}\n\t},\n\tsaveToSentItems: true\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Report\" doc:id\u003d\"48820653-b360-4262-b6f6-2ba334fc5f5f\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL REPORT\", \"dryRun\": vars.labelReport.dryRun, \"sentByWebhook\": vars.labelReport.byWebhook, \"sentBySweep\": vars.labelReport.bySweep, \"wouldSend\": vars.labelReport.wouldSend, \"failing\": vars.labelReport.failing, \"rejected\": vars.labelReport.rejected, \"otherLabels\": vars.labelReport.otherLabels, \"notDelivered\": vars.labelReport.notDelivered map {label: $.label, partner: $.partner, status: $.status}}]\"\u003e\u003c/logger\u003e\r\n\u003cchoice doc:name\u003d\"Email Report?\" doc:id\u003d\"2646f75a-049a-44c9-baaa-e3366b241dcd\"\u003e\r\n\u003cwhen expression\u003d\"#[p(\u0027labelSweep.reportEmail\u0027) \u003d\u003d \u0027true\u0027]\"\u003e\r\n\u003ctry doc:name\u003d\"Email\" doc:id\u003d\"6056ffc2-db39-4842-b74f-eec536ebfcb7\"\u003e\r\n\u003cflow-ref doc:name\u003d\"label-report-email-flow\" doc:id\u003d\"55e337be-9cb4-4f78-9ba6-325f7839a858\" name\u003d\"label-report-email-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Emailed\" doc:id\u003d\"de4764d8-eb68-48e4-9941-2020ce4b8cbf\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL REPORT\", \"messages\": \"Report emailed\", \"via\": \"graph\", \"to\": p(\"labelSweep.reportTo\")}]\"\u003e\u003c/logger\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"true\" logException\u003d\"false\" doc:name\u003d\"Email Failed\" doc:id\u003d\"140a39b9-6b0e-42f1-83e7-437d6b869b54\"\u003e\r\n\u003clogger level\u003d\"WARN\" doc:name\u003d\"Log Email Failed\" doc:id\u003d\"40ce5850-9fbf-4a50-a277-4e89cf653428\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL REPORT\", \"messages\": \"Report email failed\", \"step\": vars.emailStep default null, \"errorType\": (error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\"), \"httpStatus\": error.errorMessage.attributes.statusCode default null}]\"\u003e\u003c/logger\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003c/sub-flow\u003e","startColumn":2,"startLine":842},"groupModelName":"General","modelName":"name","value":{"aString":"label-report-flow"},"defaultValue":false}],"componentId":"label-report-flow","extensionModel":{"name":"mule"},"modelName":"subFlow","modelType":"CONSTRUCT","annotations":{"{http://www.mulesoft.org/schema/mule/documentation}id":"8817c489-6c0c-46a8-a951-b636555459f8"}},{"directChildren":[{"directChildren":[],"componentType":"OPERATION","identifier":{"name":"set-variable","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"location":{"name":"label-report-email-flow","parts":[{"partPath":"label-report-email-flow","partIdentifier":{"identifier":{"name":"sub-flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"SUB_FLOW"}},"fileName":"implementation/shipment.xml","line":967,"column":2},{"partPath":"processors"},{"partPath":"0","partIdentifier":{"identifier":{"name":"set-variable","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"OPERATION"}},"fileName":"implementation/shipment.xml","line":968,"column":3}],"location":"label-report-email-flow/processors/0"},"metadata":{"docAttributes":{"name":"Step Token","id":"c7fda1d3-7b5d-430a-9be4-6857fa552612"},"endColumn":126,"endLine":968,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":126},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":968},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":968},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":968},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":126},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":968},"IS_SELF_CLOSING":{"type":"java.lang.Boolean","value":true}},"sourceCode":"\u003cset-variable variableName\u003d\"emailStep\" value\u003d\"token\" doc:name\u003d\"Step Token\" doc:id\u003d\"c7fda1d3-7b5d-430a-9be4-6857fa552612\"\u003e\u003c/set-variable\u003e","startColumn":3,"startLine":968},"parameters":[{"unresolvedVal