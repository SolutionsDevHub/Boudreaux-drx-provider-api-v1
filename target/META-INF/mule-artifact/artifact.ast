Message \u003d vars.error.errorMessage\nvar partnerText \u003d if (partnerMessage is String) partnerMessage\n\telse if ((partnerMessage is Object) or (partnerMessage is Array)) write(partnerMessage, \"application/json\", {indent: false})\n\telse \"\"\nvar detail \u003d if (halted) ((vars.error.errorType default \"\") ++ \" \" ++ partnerText)\n\telse ((error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\"))\n---\n{\n\t\"status\": if (halted) \"rejected\" else \"failed\",\n\t\"httpStatus\": null,\n\t\"error\": if (sizeOf(detail) \u003e 300) detail[0 to 299] else detail\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cflow-ref doc:name\u003d\"label-mark-flow\" doc:id\u003d\"5f66ff0e-c3d0-4d47-b243-2c67725118c2\" name\u003d\"label-mark-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"#[vars.labelRecord.status]\" doc:name\u003d\"Outcome Failed\" doc:id\u003d\"9948b569-be4c-4eb4-9530-3a718049f139\"\u003e\u003c/set-variable\u003e\r\n\u003c/on-error-propagate\u003e","startColumn":11,"startLine":221},"parameters":[{"groupModelName":"General","modelName":"when","value":{},"defaultValue":true},{"groupModelName":"General","modelName":"type","value":{},"defaultValue":true},{"unresolvedValue":"true","metadata":{"docAttributes":{"name":"Record Failure","id":"89480c19-02e3-4f47-b079-202cac0ebf05"},"endColumn":32,"endLine":244,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":11},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":32},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":221},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":221},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":244},"CLOSING_TAG_ST