 rows \u003d vars.dbSearchResponse default []\nvar code \u003d rows[0].provider_code default \"\"\n// provider_external_id is the partner\u0027s own id; external_id is only the row key\nfun extOf(row) \u003d if (isEmpty(row.provider_external_id)) row.external_id else row.provider_external_id\nfun refOf(row) \u003d do {\n\tvar ext \u003d extOf(row)\n\t---\n\tif (ext is String) (if (ext startsWith (code ++ \":\")) substringAfter(ext, \":\") else ext) else ext\n}\nvar mine \u003d rows filter ((r) -\u003e r.provider_code \u003d\u003d code)\n---\n{\n\tcode: code,\n\tref: if (isEmpty(mine)) null else refOf(mine[0]),\n\tsource: if (isEmpty(code)) null else \"db\",\n\tprescriptionId: vars.routing.prescriptionId,\n\t// the partner\u0027s order id for each of its prescriptions on this label\n\trefsByRx: {( mine map ((r) -\u003e { ((r.drx_id default \"\") as String): refOf(r) }) )}\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e","startColumn":5,"startLine":65},"parameters":[{"groupModelName":"Message","modelName":"setPayload","value":{},"defaultValue":true},{"groupModelName":"Message","modelName":"setAttributes","value":{},"defaultValue":true},{"metadata":{"docAttributes":{},"endColumn":21,"endLine":90,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":6},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":21},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":67},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":67},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":90},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":6},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":20},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":90},"DECLARED_PREFIX":{"type":"java.lang.String","v