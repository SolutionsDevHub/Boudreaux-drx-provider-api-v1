yCount\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nvars.retryCount - 1]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cee:transform doc:name\u003d\"Email Template\" doc:id\u003d\"2b8301bc-085a-42e3-b4a5-85b3cb2fad82\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable resource\u003d\"dwl/email.dwl\" variableName\u003d\"email\"\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cflow-ref doc:name\u003d\"common-email-flow\" doc:id\u003d\"c5232716-0034-49b4-9023-c214825ee240\" name\u003d\"common-email-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003clogger level\u003d\"ERROR\" doc:name\u003d\"Retries Exhausted\" doc:id\u003d\"7e51f932-c9b5-42eb-91ee-14d26a5dfe8e\" message\u003d\"#[%dw 2.0\noutput application/json\n---\n{\n \"Event\": \"RETRIES EXHAUSTED\",\n \"messages\": \"Webhook could not be delivered to the partner after all retries; dropped from the retry queue\",\n \"CorrelationId\": payload.correlationId,\n \"Path\": payload.flowName,\n \"RetryCount\": payload.retryCount\n}]\"\u003e\u003c/logger\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e\r\n\u003cerror-handler ref\u003d\"global-error-handler\"\u003e\u003c/error-handler\u003e\r\n\u003c/flow\u003e","startColumn":2,"startLine":11},"groupModelName":"General","modelName":"initialState","value":{"aString":"started"},"defaultValue":true},{"groupModelName":"General","modelName":"maxConcurrency","value":{},"defaultValue":true},{"groupModelName":"Business Events","modelName":"enableDefaultEvents","value":{"aBoolean":false},"defaultValue":true}],"componentId":"subscriber-flow","extensionModel":{"name":"mule"},"modelName":"flow","modelType":"CONSTRUCT","annotations":{"{http://www.mulesoft.org/schema/mule/documentation}id":"a1aaedbc-03b2-487d-b686-675be76c62d4"}},{"directChildren":[{"directChildren":[{"directChildren":[],"componentType":"OPERATI