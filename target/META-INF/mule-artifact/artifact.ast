03d\"Sweep Settings\" doc:id\u003d\"4123e331-3c80-41b0-a007-daa09e7c2a58\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"sweep\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\n{\n\tdryRun: p(\u0027labelSweep.dryRun\u0027) \u003d\u003d \u0027true\u0027,\n\tsettleMinutes: p(\u0027labelSweep.settleMinutes\u0027) as Number,\n\tlookbackHours: p(\u0027labelSweep.lookbackHours\u0027) as Number,\n\tmaxPages: p(\u0027labelSweep.maxPages\u0027) as Number,\n\tmaxLabels: p(\u0027labelSweep.maxLabelsPerRun\u0027) as Number,\n\tfixture: !isEmpty(p(\u0027labelSweep.fixtureLabels\u0027) default \"\"),\n\tstartedAt: now()\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"sweepCounts\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\n{ sent: 0, dry_run: 0, already: 0, not_partner: 0, no_webhook_url: 0, no_fills: 0, lookup_failed: 0, failed: 0, rejected: 0, unknown: 0 }]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"retryCounts\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\n{ sent: 0, already: 0, failed: 0, rejected: 0, unknown: 0 }]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable resource\u003d\"dwl/connection.dwl\" variableName\u003d\"connectionDetails\"\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"realLabels\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\n[]]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"newLabels\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\n[]]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"pagingDone\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nfalse]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"listFailed\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nfalse]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003ctry doc:name\u003d\"Tables\" doc:id\u003d\"dc8505fc-b1a0-4675-b2f3-6e5b5dc41be6\"\u003e\r\n\u003cdb:execute-ddl doc:name\u003d\"Ledger Table\" doc:id\u003d\"d52cea0f-02f6-40f5-a2c5-d588bd05c222\" config-ref\u003d\"Database_Config\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelDeliveryDdl}]]\u003e\u003c/db:sql\u003e\r\n\u003c/db:execute-ddl\u003e\r\n\u003cdb:execute-ddl doc:name\u003d\"State Table\" doc:id\u003d\"430d3c3e-f69e-4d3c-8bdd-d6f2f5710468\" config-ref\u003d\"Database_Config\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelStateDdl}]]\u003e\u003c/db:sql\u003e\r\n\u003c/db:execute-ddl\u003e\r\n\u003cdb:execute-ddl doc:name\u003d\"Test Catcher Table\" doc:id\u003d\"94d2fb9f-0123-4d47-b6d4-03ab14dd91e6\" config-ref\u003d\"Database_Config\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.testCatcherDdl}]]\u003e\u003c/db:sql\u003e\r\n\u003c/db:execute-ddl\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"true\" logException\u003d\"false\" doc:name\u003d\"Tables Not Created\" doc:id\u003d\"b87ad2a6-b976-4981-96c2-1aa93e38b001\"\u003e\r\n\u003clogger level\u003d\"WARN\" doc:name\u003d\"Log Tables\" doc:id\u003d\"324c465d-63b8-4dca-8cdf-428a6829f76b\" message\u003d\"#[output application/json --- {\"messages\": \"Label sweep could not create its tables\", \"errorType\": (error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\")}]\"\u003e\u003c/logger\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003cdb:select doc:name\u003d\"Sweep State\" doc:id\u003d\"8c1a729e-b856-4351-aa9e-0f021ce0d93f\" config-ref\u003d\"Database_Config\" target\u003d\"sweepState\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelStateGet}]]\u003e\u003c/db:sql\u003e\r\n\u003c/db:select\u003e\r\n\u003cee:transform doc:name\u003d\"Read State\" doc:id\u003d\"6b8cafaf-621d-458a-a106-adfffa84db9e\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"baseline\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nvar v \u003d ((vars.sweepState default []) filter ($.name \u003d\u003d \"baseline_label_id\"))[0].value\n---\nif (isEmpty(v)) null else (v as Number)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"highWater\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nvar v \u003d ((vars.sweepState default []) filter ($.name \u003d\u003d \"high_water_label_id\"))[0].value\n---\nif (isEmpty(v)) 0 else (v as Number)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"First Run?\" doc:id\u003d\"1f61bf54-8167-4010-8ae6-ce1a5294f236\"\u003e\r\n\u003cwhen expression\u003d\"#[vars.baseline \u003d\u003d null]\"\u003e\r\n\u003ctry doc:name\u003d\"Newest Label\" doc:id\u003d\"86a3cbc6-9f1c-4fe3-a138-d9e4f6f66c86\"\u003e\r\n\u003chttp:request method\u003d\"GET\" doc:name\u003d\"DRX Newest Labels\" doc:id\u003d\"84ebf0a2-2316-4929-8261-31d39fed2bfb\" config-ref\u003d\"DRX_Label_Request_Config\" path\u003d\"/shipping/labels\" target\u003d\"drxPage\" responseTimeout\u003d\"60000\"\u003e\r\n\u003chttp:headers\u003e\u003c![CDATA[#[{\"X-DRX-Key\": p(\u0027secure::drx.key\u0027), \"Accept\": \"application/json\"}]]]\u003e\u003c/http:headers\u003e\r\n\u003chttp:query-params\u003e\u003c![CDATA[#[{\"limit\": 100, \"offset\": 0}]]]\u003e\u003c/http:query-params\u003e\r\n\u003c/http:request\u003e\r\n\u003cset-variable variableName\u003d\"baselineValue\" value\u003d\"#[max((vars.drxPage.shipments default []) map ($.id as Number)) default 0]\" doc:name\u003d\"Baseline Value\" doc:id\u003d\"a1687ced-aa39-4429-a009-2e3a625e8e6c\"\u003e\u003c/set-variable\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"true\" logException\u003d\"false\" doc:name\u003d\"No Baseline\" doc:id\u003d\"63d7ad3c-39a4-4b3e-a695-b22a343a0fc3\"\u003e\r\n\u003clogger level\u003d\"ERROR\" doc:name\u003d\"Log No Baseline\" doc:id\u003d\"4758ab18-6531-4ecd-b5da-825589705493\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL SWEEP\", \"messages\": \"Cannot read DRX shipping labels; the sweep will try again next run\", \"errorType\": (error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\"), \"httpStatus\": error.errorMessage.attributes.statusCode default null}]\"\u003e\u003c/logger\u003e\r\n\u003cset-variable variableName\u003d\"baselineValue\" value\u003d\"#[if (vars.sweep.fixture) 0 else null]\" doc:name\u003d\"Baseline Value\" doc:id\u003d\"5ac12cd0-becf-4491-aa0b-2047d6f2bb0b\"\u003e\u003c/set-variable\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003cchoice doc:name\u003d\"Baseline Found?\" doc:id\u003d\"c3b5758e-7ebc-4f22-a941-fa010934a456\"\u003e\r\n\u003cwhen expression\u003d\"#[vars.baselineValue !\u003d null]\"\u003e\r\n\u003cdb:insert doc:name\u003d\"Save Baseline\" doc:id\u003d\"d1d46e51-437f-4f72-967e-3ae8150887c4\" config-ref\u003d\"Database_Config\" target\u003d\"stateResult\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelStateSet}]]\u003e\u003c/db:sql\u003e\r\n\u003cdb:input-parameters\u003e\u003c![CDATA[#[{\"name\": \"baseline_label_id\", \"value\": vars.baselineValue as String}]]]\u003e\u003c/db:input-parameters\u003e\r\n\u003c/db:insert\u003e\r\n\u003cdb:insert doc:name\u003d\"Save High Water\" doc:id\u003d\"1419e9e5-f99c-4cde-a73a-5f8036a86102\" config-ref\u003d\"Database_Config\" target\u003d\"stateResult\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelStateSet}]]\u003e\u003c/db:sql\u003e\r\n\u003cdb:input-parameters\u003e\u003c![CDATA[#[{\"name\": \"high_water_label_id\", \"value\": vars.baselineValue as String}]]]\u003e\u003c/db:input-parameters\u003e\r\n\u003c/db:insert\u003e\r\n\u003cset-variable variableName\u003d\"baseline\" value\u003d\"#[vars.baselineValue]\" doc:name\u003d\"Baseline\" doc:id\u003d\"1e388c5b-3c6f-4421-b1aa-4e6d2bd5cb44\"\u003e\u003c/set-variable\u003e\r\n\u003cset-variable variableName\u003d\"highWater\" value\u003d\"#[vars.baselineValue]\" doc:name\u003d\"High Water\" doc:id\u003d\"c217b657-d841-48a2-85ce-663f41b19441\"\u003e\u003c/set-variable\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Baseline\" doc:id\u003d\"7a009783-c0ef-48b3-b1ee-0fb31a32a59c\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL SWEEP\", \"messages\": \"Baseline set: the sweep checks DRX labels newer than this one\", \"baseline\": vars.baseline}]\"\u003e\u003c/logger\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003cchoice doc:name\u003d\"Baseline Known?\" doc:id\u003d\"a515bc9b-751e-4cdd-8f73-d9553436439d\"\u003e\r\n\u003cwhen expression\u003d\"#[vars.baseline !\u003d null]\"\u003e\r\n\u003cforeach doc:name\u003d\"DRX Label Pages\" doc:id\u003d\"f7270de3-13a9-4f37-b205-cc504a4d8d3a\" collection\u003d\"#[(0 to ((vars.sweep.maxPages as Number) - 1)) as Array]\"\u003e\r\n\u003cchoice doc:name\u003d\"More Pages?\" doc:id\u003d\"9c24c397-c7a9-45ab-9152-0ad36deb9459\"\u003e\r\n\u003cwhen expression\u003d\"#[!(vars.pagingDone)]\"\u003e\r\n\u003cset-variable variableName\u003d\"pageIndex\" value\u003d\"#[payload as Number]\" doc:name\u003d\"Page Index\" doc:id\u003d\"bd886f4b-c885-4958-bd17-cfba8aadc0f8\"\u003e\u003c/set-variable\u003e\r\n\u003ctry doc:name\u003d\"Read Page\" doc:id\u003d\"e50cfbfa-3bd5-49a8-92cf-520c9642b4af\"\u003e\r\n\u003chttp:request method\u003d\"GET\" doc:name\u003d\"DRX Labels\" doc:id\u003d\"67481af2-6e4f-4957-b064-5fe35a852ebb\" config-ref\u003d\"DRX_Label_Request_Config\" path\u003d\"/shipping/labels\" target\u003d\"drxPage\" responseTimeout\u003d\"60000\"\u003e\r\n\u003chttp:headers\u003e\u003c![CDATA[#[{\"X-DRX-Key\": p(\u0027secure::drx.key\u0027), \"Accept\": \"application/json\"}]]]\u003e\u003c/http:headers\u003e\r\n\u003chttp:query-params\u003e\u003c![CDATA[#[{\"limit\": 100, \"offset\": vars.pageIndex * 100}]]]\u003e\u003c/http:query-params\u003e\r\n\u003c/http:request\u003e\r\n\u003cee:transform doc:name\u003d\"Collect Page\" doc:id\u003d\"8977143f-d743-4d53-a866-c7b29efa9fce\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"realLabels\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nvar rows \u003d vars.drxPage.shipments default []\n---\nvars.realLabels ++ (rows map ((l) -\u003e {\n\tid: l.id,\n\tprescription_fill_id: l.prescription_fill_id,\n\tpacking_list_id: l.packing_list_id,\n\ttracking_number: l.tracking_number,\n\tcarrier_code: l.carrier_code,\n\tservice_code: l.service_code,\n\tcreated_at: l.created_at,\n\tvoided: l.voided default false\n}))]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"pagingDone\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nfun epochOf(s) \u003d if ((s is String) and (sizeOf(s) \u003e\u003d 19)) (((s[0 to 18] ++ \"Z\") as DateTime) as Number {unit: \"seconds\"}) else 0\nvar rows \u003d vars.drxPage.shipments default []\nvar stopId \u003d max([vars.baseline as Number, (vars.highWater as Number) - 100])\nvar lookbackS \u003d (now() as Number {unit: \"seconds\"}) - ((vars.sweep.lookbackHours as Number) * 3600)\n---\nisEmpty(rows)\n\tor ((min(rows map ($.id as Number)) default 0) \u003c\u003d stopId)\n\tor ((min(rows map epochOf($.created_at)) default 0) \u003c lookbackS)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"drxPage\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nnull]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"true\" logException\u003d\"false\" doc:name\u003d\"List Failed\" doc:id\u003d\"91c83fe8-f724-4ef0-99d8-e3746d571d1c\"\u003e\r\n\u003clogger level\u003d\"ERROR\" doc:name\u003d\"Log List Failed\" doc:id\u003d\"54a359f2-56db-4cb5-a21a-5b972adb8b5a\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL SWEEP\", \"messages\": \"Cannot read DRX shipping labels\", \"page\": vars.pageIndex, \"errorType\": (error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\"), \"httpStatus\": error.errorMessage.attributes.statusCode default null}]\"\u003e\u003c/logger\u003e\r\n\u003cset-variable variableName\u003d\"pagingDone\" value\u003d\"#[true]\" doc:name\u003d\"Stop Paging\" doc:id\u003d\"40b23e45-1a46-4533-89f3-2aff53d6dc9a\"\u003e\u003c/set-variable\u003e\r\n\u003cset-variable variableName\u003d\"listFailed\" value\u003d\"#[true]\" doc:name\u003d\"List Failed\" doc:id\u003d\"cf8bc657-8d1b-4b90-ba97-0120d65ee87b\"\u003e\u003c/set-variable\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003c/foreach\u003e\r\n\u003cee:transform doc:name\u003d\"Candidates\" doc:id\u003d\"0f16dd64-4f28-4d1c-901e-04b57d583d2b\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"candidateInfo\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nfun epochOf(s) \u003d if ((s is String) and (sizeOf(s) \u003e\u003d 19)) (((s[0 to 18] ++ \"Z\") as DateTime) as Number {unit: \"seconds\"}) else 0\nvar settleS \u003d (now() as Number {unit: \"seconds\"}) - ((vars.sweep.settleMinutes as Number) * 60)\n// DEV only: test labels from config, routed through the real DRX lookups and the real partner call\nvar fixtures \u003d if (vars.sweep.fixture) read(p(\u0027labelSweep.fixtureLabels\u0027), \"application/json\") else []\nvar all \u003d (vars.realLabels ++ fixtures) distinctBy ($.id)\nvar eligible \u003d (all filter ((l) -\u003e ((l.id as Number) \u003e (vars.baseline as Number))\n\tand !(l.voided default false)\n\tand !(isEmpty(l.tracking_number))\n\tand (epochOf(l.created_at) \u003c\u003d settleS))) orderBy ($.id as Number)\nvar capped \u003d if (sizeOf(eligible) \u003e vars.sweep.maxLabels) eligible[0 to (vars.sweep.maxLabels - 1)] else eligible\nvar fixtureIds \u003d fixtures map ($.id as Number)\nvar olderReal \u003d (vars.realLabels filter (epochOf($.created_at) \u003c\u003d settleS)) map ($.id as Number)\nvar cappedReal \u003d (capped map ($.id as Number)) filter ((i) -\u003e !(fixtureIds contains i))\n---\n{\n\tread: sizeOf(vars.realLabels),\n\tfixtures: sizeOf(fixtures),\n\teligible: sizeOf(eligible),\n\tcandidates: capped,\n\t// next run pages back to this id (minus a margin); when capped, only as far as this run got\n\thighWater: if (sizeOf(eligible) \u003e vars.sweep.maxLabels) (max(cappedReal) default vars.highWater) else (max(olderReal) default vars.highWater)\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Any Candidates?\" doc:id\u003d\"2692709b-b312-4529-bbb2-7231252ae4eb\"\u003e\r\n\u003cwhen expression\u003d\"#[!(isEmpty(vars.candidateInfo.candidates))]\"\u003e\r\n\u003cdb:select doc:name\u003d\"Labels Already Handled\" doc:id\u003d\"6085de07-86fa-43f5-8115-2f100e576b20\" config-ref\u003d\"Database_Config\" target\u003d\"knownRows\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelKnown}]]\u003e\u003c/db:sql\u003e\r\n\u003cdb:input-parameters\u003e\u003c![CDATA[#[{\"ids\": (vars.candidateInfo.candidates map ($.id as String)) joinBy \",\"}]]]\u003e\u003c/db:input-parameters\u003e\r\n\u003c/db:select\u003e\r\n\u003cset-variable variableName\u003d\"newLabels\" value\u003d\"#[%dw 2.0\noutput application/java\nvar known \u003d (vars.knownRows default []) map ($.label_id as Number)\n---\nvars.candidateInfo.candidates filter ((l) -\u003e !(known contains (l.id as Number)))]\" doc:name\u003d\"New Labels\" doc:id\u003d\"89325185-6737-4c66-83fc-df6f7df4132a\"\u003e\u003c/set-variable\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003cforeach doc:name\u003d\"New Labels\" doc:id\u003d\"5cbd2114-a4f9-480b-9657-9bfe7631c7ec\" collection\u003d\"#[vars.newLabels]\"\u003e\r\n\u003cee:transform doc:name\u003d\"Start Label\" doc:id\u003d\"223ce995-bd63-4144-a80c-099bff9efb7f\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"label\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\npayload]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"shipmentNumber\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\npayload.id]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"labelSource\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\n\"sweep\"]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"labelDryRun\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nvars.sweep.dryRun]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"labelOutcome\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nnull]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"provider\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nnull]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"error\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nnull]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"haltFlow\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nfalse]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003ctry doc:name\u003d\"One Label\" doc:id\u003d\"76ca125a-49af-49da-bf6d-fc2b86474010\"\u003e\r\n\u003cflow-ref doc:name\u003d\"label-sweep-one-flow\" doc:id\u003d\"feb01be6-5b34-43ff-a7b0-3d4a3314d27d\" name\u003d\"label-sweep-one-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"true\" logException\u003d\"false\" doc:name\u003d\"Label Failed\" doc:id\u003d\"3df908ef-adb3-4c3b-a63b-274b93373111\"\u003e\r\n\u003cchoice doc:name\u003d\"Lookup Failed?\" doc:id\u003d\"a0492a68-9987-4652-acbf-6eef45d5832a\"\u003e\r\n\u003cwhen expression\u003d\"#[!([\u0027failed\u0027, \u0027rejected\u0027] contains (vars.labelOutcome default \u0027\u0027))]\"\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"lookup_failed\" doc:name\u003d\"Outcome Lookup Failed\" doc:id\u003d\"7a3d5b49-8707-4d5f-94e4-d69f90c9ff44\"\u003e\u003c/set-variable\u003e\r\n\u003cset-variable variableName\u003d\"labelRecord\" value\u003d\"#[{\"status\": \"lookup_failed\", \"provider\": \"-\", \"error\": ((error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\")) ++ \" \" ++ ((error.errorMessage.attributes.statusCode default \"\") as String), \"withPayload\": false}]\" doc:name\u003d\"Lookup Failed Record\" doc:id\u003d\"46a8e9b0-d3a4-4959-b022-1b8c45d2f62e\"\u003e\u003c/set-variable\u003e\r\n\u003cflow-ref doc:name\u003d\"label-record-flow\" doc:id\u003d\"bcd414a3-365b-4154-bb33-cf044bb650f3\" name\u003d\"label-record-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003clogger level\u003d\"WARN\" doc:name\u003d\"Log Lookup Failed\" doc:id\u003d\"727202fb-ab34-486f-869b-b4a6e135b6e8\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL SWEEP\", \"messages\": \"Could not read this label\u0027s fills from DRX\", \"shipment_id\": vars.shipmentNumber, \"errorType\": (error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\"), \"httpStatus\": error.errorMessage.attributes.statusCode default null}]\"\u003e\u003c/logger\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003cee:transform doc:name\u003d\"Count Outcome\" doc:id\u003d\"b961b6de-9a8b-4d02-821e-55565ebcf7cd\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"sweepCounts\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nvar k \u003d if (vars.sweepCounts[vars.labelOutcome default \"unknown\"] !\u003d null) (vars.labelOutcome default \"unknown\") else \"unknown\"\n---\nvars.sweepCounts mapObject ((v, key) -\u003e { (key): if ((key as String) \u003d\u003d k) v + 1 else v })]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"drxFill\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nnull]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"drxPackingList\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nnull]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/foreach\u003e\r\n\u003cchoice doc:name\u003d\"Live?\" doc:id\u003d\"82073250-027c-40f2-bdce-b063a0aee745\"\u003e\r\n\u003cwhen expression\u003d\"#[!(vars.sweep.dryRun)]\"\u003e\r\n\u003cdb:select doc:name\u003d\"Labels To Retry\" doc:id\u003d\"ae40001a-2c79-4f73-bc21-7057817fe244\" config-ref\u003d\"Database_Config\" target\u003d\"retryRows\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelRetrySelect}]]\u003e\u003c/db:sql\u003e\r\n\u003cdb:input-parameters\u003e\u003c![CDATA[#[{\"max_attempts\": p(\u0027labelSweep.maxAttempts\u0027), \"window_hours\": p(\u0027labelSweep.retryWindowHours\u0027), \"retry_minutes\": p(\u0027labelSweep.retryMinutes\u0027), \"backfill_hours\": p(\u0027labelSweep.backfillHours\u0027)}]]]\u003e\u003c/db:input-parameters\u003e\r\n\u003c/db:select\u003e\r\n\u003cforeach doc:name\u003d\"Retries\" doc:id\u003d\"0cb3b855-6f74-443a-96f4-30606496b161\" collection\u003d\"#[vars.retryRows default []]\"\u003e\r\n\u003cee:transform doc:name\u003d\"Start Retry\" doc:id\u003d\"7c3f68b9-d265-4c43-b350-1208f52d3c14\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nread(payload.payload default \"{}\", \"application/json\")]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"provider\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\npayload.provider_code]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"shipmentNumber\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\npayload.label_id]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"labelSource\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\n\"retry\"]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"labelDryRun\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nfalse]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"labelOutcome\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nnull]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"error\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nnull]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"haltFlow\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nfalse]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003ctry doc:name\u003d\"Retry Label\" doc:id\u003d\"f07d2f1c-3d60-4027-a14d-53a925145c59\"\u003e\r\n\u003cflow-ref doc:name\u003d\"deliver-label-flow\" doc:id\u003d\"1af82ed3-8b16-4b6c-97af-b47ec47aa1ff\" name\u003d\"deliver-label-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"true\" logException\u003d\"false\" doc:name\u003d\"Retry Failed\" doc:id\u003d\"1d22c4ce-4b6f-40b2-aff7-56bc28cdc117\"\u003e\r\n\u003clogger level\u003d\"WARN\" doc:name\u003d\"Log Retry Failed\" doc:id\u003d\"b18a5ee4-3cdf-4f7c-8244-0134a63e3846\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL SWEEP\", \"messages\": \"Retry did not deliver the label\", \"provider\": vars.provider, \"shipment_id\": vars.shipmentNumber, \"outcome\": vars.labelOutcome}]\"\u003e\u003c/logger\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003cee:transform doc:name\u003d\"Count Retry\" doc:id\u003d\"e74db9db-a630-4075-93ec-6bdb6742dfe9\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"retryCounts\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nvar k \u003d if (vars.retryCounts[vars.labelOutcome default \"unknown\"] !\u003d null) (vars.labelOutcome default \"unknown\") else \"unknown\"\n---\nvars.retryCounts mapObject ((v, key) -\u003e { (key): if ((key as String) \u003d\u003d k) v + 1 else v })]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/foreach\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003cchoice doc:name\u003d\"High Water Moved?\" doc:id\u003d\"d026af65-91d7-4279-a95f-9bddf2d7a22c\"\u003e\r\n\u003cwhen expression\u003d\"#[(vars.candidateInfo.highWater default 0) \u003e (vars.highWater default 0)]\"\u003e\r\n\u003cdb:insert doc:name\u003d\"Save High Water\" doc:id\u003d\"114ed507-f108-4179-9044-e92b11f0150d\" config-ref\u003d\"Database_Config\" target\u003d\"stateResult\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelStateSet}]]\u003e\u003c/db:sql\u003e\r\n\u003cdb:input-parameters\u003e\u003c![CDATA[#[{\"name\": \"high_water_label_id\", \"value\": vars.candidateInfo.highWater as String}]]]\u003e\u003c/db:input-parameters\u003e\r\n\u003c/db:insert\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Sweep\" doc:id\u003d\"3cb75e32-4085-46eb-9296-0709aa3c02dd\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL SWEEP\", \"dryRun\": vars.sweep.dryRun, \"baseline\": vars.baseline, \"labelsRead\": vars.candidateInfo.read, \"testLabels\": vars.candidateInfo.fixtures, \"eligible\": vars.candidateInfo.eligible, \"new\": sizeOf(vars.newLabels default []), \"outcomes\": vars.sweepCounts, \"retries\": vars.retryCounts, \"drxListFailed\": vars.listFailed, \"seconds\": (now() - vars.sweep.startedAt).seconds}]\"\u003e\u003c/logger\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003c/sub-flow\u003e","startColumn":2,"startLine":380},"parameters":[{"unresolvedValue":"label-sweep-run-flow","metadata":{"docAttributes":{"id":"641bba60-08d8-4e2c-b70d-302602d36de6"},"endColumn":13,"endLine":737,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":13},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":380},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":380},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":737},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":86},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":737}},"sourceCode":"\u003csub-flow name\u003d\"label-sweep-run-flow\" doc:id\u003d\"641bba60-08d8-4e2c-b70d-302602d36de6\"\u003e\r\n\u003cee:transform doc:name\u003d\"Sweep Settings\" doc:id\u003d\"4123e331-3c80-41b0-a007-daa09e7c2a58\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"sweep\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\n{\n\tdryRun: p(\u0027labelSweep.dryRun\u0027) \u003d\u003d \u0027true\u0027,\n\tsettleMinutes: p(\u0027labelSweep.settleMinutes\u0027) as Number,\n\tlookbackHours: p(\u0027labelSweep.lookbackHours\u0027) as Number,\n\tmaxPages: p(\u0027labelSweep.maxPages\u0027) as Number,\n\tmaxLabels: p(\u0027labelSweep.maxLabelsPerRun\u0027) as Number,\n\tfixture: !isEmpty(p(\u0027labelSweep.fixtureLabels\u0027) default \"\"),\n\tstartedAt: now()\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"sweepCounts\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\n{ sent: 0, dry_run: 0, already: 0, not_partner: 0, no_webhook_url: 0, no_fills: 0, lookup_failed: 0, failed: 0, rejected: 0, unknown: 0 }]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"retryCounts\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\n{ sent: 0, already: 0, failed: 0, rejected: 0, unknown: 0 }]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable resource\u003d\"dwl/connection.dwl\" variableName\u003d\"connectionDetails\"\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"realLabels\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\n[]]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"newLabels\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\n[]]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"pagingDone\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nfalse]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"listFailed\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nfalse]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003ctry doc:name\u003d\"Tables\" doc:id\u003d\"dc8505fc-b1a0-4675-b2f3-6e5b5dc41be6\"\u003e\r\n\u003cdb:execute-ddl doc:name\u003d\"Ledger Table\" doc:id\u003d\"d52cea0f-02f6-40f5-a2c5-d588bd05c222\" config-ref\u003d\"Database_Config\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelDeliveryDdl}]]\u003e\u003c/db:sql\u003e\r\n\u003c/db:execute-ddl\u003e\r\n\u003cdb:execute-ddl doc:name\u003d\"State Table\" doc:id\u003d\"430d3c3e-f69e-4d3c-8bdd-d6f2f5710468\" config-ref\u003d\"Database_Config\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelStateDdl}]]\u003e\u003c/db:sql\u003e\r\n\u003c/db:execute-ddl\u003e\r\n\u003cdb:execute-ddl doc:name\u003d\"Test Catcher Table\" doc:id\u003d\"94d2fb9f-0123-4d47-b6d4-03ab14dd91e6\" config-ref\u003d\"Database_Config\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.testCatcherDdl}]]\u003e\u003c/db:sql\u003e\r\n\u003c/db:execute-ddl\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"true\" logException\u003d\"false\" doc:name\u003d\"Tables Not Created\" doc:id\u003d\"b87ad2a6-b976-4981-96c2-1aa93e38b001\"\u003e\r\n\u003clogger level\u003d\"WARN\" doc:name\u003d\"Log Tables\" doc:id\u003d\"324c465d-63b8-4dca-8cdf-428a6829f76b\" message\u003d\"#[output application/json --- {\"messages\": \"Label sweep could not create its tables\", \"errorType\": (error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\")}]\"\u003e\u003c/logger\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003cdb:select doc:name\u003d\"Sweep State\" doc:id\u003d\"8c1a729e-b856-4351-aa9e-0f021ce0d93f\" config-ref\u003d\"Database_Config\" target\u003d\"sweepState\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelStateGet}]]\u003e\u003c/db:sql\u003e\r\n\u003c/db:select\u003e\r\n\u003cee:transform doc:name\u003d\"Read State\" doc:id\u003d\"6b8cafaf-621d-458a-a106-adfffa84db9e\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"baseline\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nvar v \u003d ((vars.sweepState default []) filter ($.name \u003d\u003d \"baseline_label_id\"))[0].value\n---\nif (isEmpty(v)) null else (v as Number)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"highWater\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nvar v \u003d ((vars.sweepState default []) filter ($.name \u003d\u003d \"high_water_label_id\"))[0].value\n---\nif (isEmpty(v)) 0 else (v as Number)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"First Run?\" doc:id\u003d\"1f61bf54-8167-4010-8ae6-ce1a5294f236\"\u003e\r\n\u003cwhen expression\u003d\"#[vars.baseline \u003d\u003d null]\"\u003e\r\n\u003ctry doc:name\u003d\"Newest Label\" doc:id\u003d\"86a3cbc6-9f1c-4fe3-a138-d9e4f6f66c86\"\u003e\r\n\u003chttp:request method\u003d\"GET\" doc:name\u003d\"DRX Newest Labels\" doc:id\u003d\"84ebf0a2-2316-4929-8261-31d39fed2bfb\" config-ref\u003d\"DRX_Label_Request_Config\" path\u003d\"/shipping/labels\" target\u003d\"drxPage\" responseTimeout\u003d\"60000\"\u003e\r\n\u003chttp:headers\u003e\u003c![CDATA[#[{\"X-DRX-Key\": p(\u0027secure::drx.key\u0027), \"Accept\": \"application/json\"}]]]\u003e\u003c/http:headers\u003e\r\n\u003chttp:query-params\u003e\u003c![CDATA[#[{\"limit\": 100, \"offset\": 0}]]]\u003e\u003c/http:query-params\u003e\r\n\u003c/http:request\u003e\r\n\u003cset-variable variableName\u003d\"baselineValue\" value\u003d\"#[max((vars.drxPage.shipments default []) map ($.id as Number)) default 0]\" doc:name\u003d\"Baseline Value\" doc:id\u003d\"a1687ced-aa39-4429-a009-2e3a625e8e6c\"\u003e\u003c/set-variable\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"true\" logException\u003d\"false\" doc:name\u003d\"No Baseline\" doc:id\u003d\"63d7ad3c-39a4-4b3e-a695-b22a343a0fc3\"\u003e\r\n\u003clogger level\u003d\"ERROR\" doc:name\u003d\"Log No Baseline\" doc:id\u003d\"4758ab18-6531-4ecd-b5da-825589705493\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL SWEEP\", \"messages\": \"Cannot read DRX shipping labels; the sweep will try again next run\", \"errorType\": (error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\"), \"httpStatus\": error.errorMessage.attributes.statusCode default null}]\"\u003e\u003c/logger\u003e\r\n\u003cset-variable variableName\u003d\"baselineValue\" value\u003d\"#[if (vars.sweep.fixture) 0 else null]\" doc:name\u003d\"Baseline Value\" doc:id\u003d\"5ac12cd0-becf-4491-aa0b-2047d6f2bb0b\"\u003e\u003c/set-variable\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003cchoice doc:name\u003d\"Baseline Found?\" doc:id\u003d\"c3b5758e-7ebc-4f22-a941-fa010934a456\"\u003e\r\n\u003cwhen expression\u003d\"#[vars.baselineValue !\u003d null]\"\u003e\r\n\u003cdb:insert doc:name\u003d\"Save Baseline\" doc:id\u003d\"d1d46e51-437f-4f72-967e-3ae8150887c4\" config-ref\u003d\"Database_Config\" target\u003d\"stateResult\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelStateSet}]]\u003e\u003c/db:sql\u003e\r\n\u003cdb:input-parameters\u003e\u003c![CDATA[#[{\"name\": \"baseline_label_id\", \"value\": vars.baselineValue as String}]]]\u003e\u003c/db:input-parameters\u003e\r\n\u003c/db:insert\u003e\r\n\u003cdb:insert doc:name\u003d\"Save High Water\" doc:id\u003d\"1419e9e5-f99c-4cde-a73a-5f8036a86102\" config-ref\u003d\"Database_Config\" target\u003d\"stateResult\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelStateSet}]]\u003e\u003c/db:sql\u003e\r\n\u003cdb:input-parameters\u003e\u003c![CDATA[#[{\"name\": \"high_water_label_id\", \"value\": vars.baselineValue as String}]]]\u003e\u003c/db:input-parameters\u003e\r\n\u003c/db:insert\u003e\r\n\u003cset-variable variableName\u003d\"baseline\" value\u003d\"#[vars.baselineValue]\" doc:name\u003d\"Baseline\" doc:id\u003d\"1e388c5b-3c6f-4421-b1aa-4e6d2bd5cb44\"\u003e\u003c/set-variable\u003e\r\n\u003cset-variable variableName\u003d\"highWater\" value\u003d\"#[vars.baselineValue]\" doc:name\u003d\"High Water\" doc:id\u003d\"c217b657-d841-48a2-85ce-663f41b19441\"\u003e\u003c/set-variable\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Baseline\" doc:id\u003d\"7a009783-c0ef-48b3-b1ee-0fb31a32a59c\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL SWEEP\", \"messages\": \"Baseline set: the sweep checks DRX labels newer than this one\", \"baseline\": vars.baseline}]\"\u003e\u003c/logger\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003cchoice doc:name\u003d\"Baseline Known?\" doc:id\u003d\"a515bc9b-751e-4cdd-8f73-d9553436439d\"\u003e\r\n\u003cwhen expression\u003d\"#[vars.baseline !\u003d null]\"\u003e\r\n\u003cforeach doc:name\u003d\"DRX Label Pages\" doc:id\u003d\"f7270de3-13a9-4f37-b205-cc504a4d8d3a\" collection\u003d\"#[(0 to ((vars.sweep.maxPages as Number) - 1)) as Array]\"\u003e\r\n\u003cchoice doc:name\u003d\"More Pages?\" doc:id\u003d\"9c24c397-c7a9-45ab-9152-0ad36deb9459\"\u003e\r\n\u003cwhen expression\u003d\"#[!(vars.pagingDone)]\"\u003e\r\n\u003cset-variable variableName\u003d\"pageIndex\" value\u003d\"#[payload as Number]\" doc:name\u003d\"Page Index\" doc:id\u003d\"bd886f4b-c885-4958-bd17-cfba8aadc0f8\"\u003e\u003c/set-variable\u003e\r\n\u003ctry doc:name\u003d\"Read Page\" doc:id\u003d\"e50cfbfa-3bd5-49a8-92cf-520c9642b4af\"\u003e\r\n\u003chttp:request method\u003d\"GET\" doc:name\u003d\"DRX Labels\" doc:id\u003d\"67481af2-6e4f-4957-b064-5fe35a852ebb\" config-ref\u003d\"DRX_Label_Request_Config\" path\u003d\"/shipping/labels\" target\u003d\"drxPage\" responseTimeout\u003d\"60000\"\u003e\r\n\u003chttp:headers\u003e\u003c![CDATA[#[{\"X-DRX-Key\": p(\u0027secure::drx.key\u0027), \"Accept\": \"application/json\"}]]]\u003e\u003c/http:headers\u003e\r\n\u003chttp:query-params\u003e\u003c![CDATA[#[{\"limit\": 100, \"offset\": vars.pageIndex * 100}]]]\u003e\u003c/http:query-params\u003e\r\n\u003c/http:request\u003e\r\n\u003cee:transform doc:name\u003d\"Collect Page\" doc:id\u003d\"8977143f-d743-4d53-a866-c7b29efa9fce\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"realLabels\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nvar rows \u003d vars.drxPage.shipments default []\n---\nvars.realLabels ++ (rows map ((l) -\u003e {\n\tid: l.id,\n\tprescription_fill_id: l.prescription_fill_id,\n\tpacking_list_id: l.packing_list_id,\n\ttracking_number: l.tracking_number,\n\tcarrier_code: l.carrier_code,\n\tservice_code: l.service_code,\n\tcreated_at: l.created_at,\n\tvoided: l.voided default false\n}))]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"pagingDone\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nfun epochOf(s) \u003d if ((s is String) and (sizeOf(s) \u003e\u003d 19)) (((s[0 to 18] ++ \"Z\") as DateTime) as Number {unit: \"seconds\"}) else 0\nvar rows \u003d vars.drxPage.shipments default []\nvar stopId \u003d max([vars.baseline as Number, (vars.highWater as Number) - 100])\nvar lookbackS \u003d (now() as Number {unit: \"seconds\"}) - ((vars.sweep.lookbackHours as Number) * 3600)\n---\nisEmpty(rows)\n\tor ((min(rows map ($.id as Number)) default 0) \u003c\u003d stopId)\n\tor ((min(rows map epochOf($.created_at)) default 0) \u003c lookbackS)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"drxPage\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nnull]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"true\" logException\u003d\"false\" doc:name\u003d\"List Failed\" doc:id\u003d\"91c83fe8-f724-4ef0-99d8-e3746d571d1c\"\u003e\r\n\u003clogger level\u003d\"ERROR\" doc:name\u003d\"Log List Failed\" doc:id\u003d\"54a359f2-56db-4cb5-a21a-5b972adb8b5a\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL SWEEP\", \"messages\": \"Cannot read DRX shipping labels\", \"page\": vars.pageIndex, \"errorType\": (error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\"), \"httpStatus\": error.errorMessage.attributes.statusCode default null}]\"\u003e\u003c/logger\u003e\r\n\u003cset-variable variableName\u003d\"pagingDone\" value\u003d\"#[true]\" doc:name\u003d\"Stop Paging\" doc:id\u003d\"40b23e45-1a46-4533-89f3-2aff53d6dc9a\"\u003e\u003c/set-variable\u003e\r\n\u003cset-variable variableName\u003d\"listFailed\" value\u003d\"#[true]\" doc:name\u003d\"List Failed\" doc:id\u003d\"cf8bc657-8d1b-4b90-ba97-0120d65ee87b\"\u003e\u003c/set-variable\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003c/foreach\u003e\r\n\u003cee:transform doc:name\u003d\"Candidates\" doc:id\u003d\"0f16dd64-4f28-4d1c-901e-04b57d583d2b\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"candidateInfo\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nfun epochOf(s) \u003d if ((s is String) and (sizeOf(s) \u003e\u003d 19)) (((s[0 to 18] ++ \"Z\") as DateTime) as Number {unit: \"seconds\"}) else 0\nvar settleS \u003d (now() as Number {unit: \"seconds\"}) - ((vars.sweep.settleMinutes as Number) * 60)\n// DEV only: test labels from config, routed through the real DRX lookups and the real partner call\nvar fixtures \u003d if (vars.sweep.fixture) read(p(\u0027labelSweep.fixtureLabels\u0027), \"application/json\") else []\nvar all \u003d (vars.realLabels ++ fixtures) distinctBy ($.id)\nvar eligible \u003d (all filter ((l) -\u003e ((l.id as Number) \u003e (vars.baseline as Number))\n\tand !(l.voided default false)\n\tand !(isEmpty(l.tracking_number))\n\tand (epochOf(l.created_at) \u003c\u003d settleS))) orderBy ($.id as Number)\nvar capped \u003d if (sizeOf(eligible) \u003e vars.sweep.maxLabels) eligible[0 to (vars.sweep.maxLabels - 1)] else eligible\nvar fixtureIds \u003d fixtures map ($.id as Number)\nvar olderReal \u003d (vars.realLabels filter (epochOf($.created_at) \u003c\u003d settleS)) map ($.id as Number)\nvar cappedReal \u003d (capped map ($.id as Number)) filter ((i) -\u003e !(fixtureIds contains i))\n---\n{\n\tread: sizeOf(vars.realLabels),\n\tfixtures: sizeOf(fixtures),\n\teligible: sizeOf(eligible),\n\tcandidates: capped,\n\t// next run pages back to this id (minus a margin); when capped, only as far as this run got\n\thighWater: if (sizeOf(eligible) \u003e vars.sweep.maxLabels) (max(cappedReal) default vars.highWater) else (max(olderReal) default vars.highWater)\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Any Candidates?\" doc:id\u003d\"2692709b-b312-4529-bbb2-7231252ae4eb\"\u003e\r\n\u003cwhen expression\u003d\"#[!(isEmpty(vars.candidateInfo.candidates))]\"\u003e\r\n\u003cdb:select doc:name\u003d\"Labels Already Handled\" doc:id\u003d\"6085de07-86fa-43f5-8115-2f100e576b20\" config-ref\u003d\"Database_Config\" target\u003d\"knownRows\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelKnown}]]\u003e\u003c/db:sql\u003e\r\n\u003cdb:input-parameters\u003e\u003c![CDATA[#[{\"ids\": (vars.candidateInfo.candidates map ($.id as String)) joinBy \",\"}]]]\u003e\u003c/db:input-parameters\u003e\r\n\u003c/db:select\u003e\r\n\u003cset-variable variableName\u003d\"newLabels\" value\u003d\"#[%dw 2.0\noutput application/java\nvar known \u003d (vars.knownRows default []) map ($.label_id as Number)\n---\nvars.candidateInfo.candidates filter ((l) -\u003e !(known contains (l.id as Number)))]\" doc:name\u003d\"New Labels\" doc:id\u003d\"89325185-6737-4c66-83fc-df6f7df4132a\"\u003e\u003c/set-variable\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003cforeach doc:name\u003d\"New Labels\" doc:id\u003d\"5cbd2114-a4f9-480b-9657-9bfe7631c7ec\" collection\u003d\"#[vars.newLabels]\"\u003e\r\n\u003cee:transform doc:name\u003d\"Start Label\" doc:id\u003d\"223ce995-bd63-4144-a80c-099bff9efb7f\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"label\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\npayload]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"shipmentNumber\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\npayload.id]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"labelSource\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\n\"sweep\"]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"labelDryRun\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nvars.sweep.dryRun]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"labelOutcome\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nnull]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"provider\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nnull]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"error\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nnull]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"haltFlow\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nfalse]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003ctry doc:name\u003d\"One Label\" doc:id\u003d\"76ca125a-49af-49da-bf6d-fc2b86474010\"\u003e\r\n\u003cflow-ref doc:name\u003d\"label-sweep-one-flow\" doc:id\u003d\"feb01be6-5b34-43ff-a7b0-3d4a3314d27d\" name\u003d\"label-sweep-one-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"true\" logException\u003d\"false\" doc:name\u003d\"Label Failed\" doc:id\u003d\"3df908ef-adb3-4c3b-a63b-274b93373111\"\u003e\r\n\u003cchoice doc:name\u003d\"Lookup Failed?\" doc:id\u003d\"a0492a68-9987-4652-acbf-6eef45d5832a\"\u003e\r\n\u003cwhen expression\u003d\"#[!([\u0027failed\u0027, \u0027rejected\u0027] contains (vars.labelOutcome default \u0027\u0027))]\"\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"lookup_failed\" doc:name\u003d\"Outcome Lookup Failed\" doc:id\u003d\"7a3d5b49-8707-4d5f-94e4-d69f90c9ff44\"\u003e\u003c/set-variable\u003e\r\n\u003cset-variable variableName\u003d\"labelRecord\" value\u003d\"#[{\"status\": \"lookup_failed\", \"provider\": \"-\", \"error\": ((error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\")) ++ \" \" ++ ((error.errorMessage.attributes.statusCode default \"\") as String), \"withPayload\": false}]\" doc:name\u003d\"Lookup Failed Record\" doc:id\u003d\"46a8e9b0-d3a4-4959-b022-1b8c45d2f62e\"\u003e\u003c/set-variable\u003e\r\n\u003cflow-ref doc:name\u003d\"label-record-flow\" doc:id\u003d\"bcd414a3-365b-4154-bb33-cf044bb650f3\" name\u003d\"label-record-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003clogger level\u003d\"WARN\" doc:name\u003d\"Log Lookup Failed\" doc:id\u003d\"727202fb-ab34-486f-869b-b4a6e135b6e8\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL SWEEP\", \"messages\": \"Could not read this label\u0027s fills from DRX\", \"shipment_id\": vars.shipmentNumber, \"errorType\": (error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\"), \"httpStatus\": error.errorMessage.attributes.statusCode default null}]\"\u003e\u003c/logger\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003cee:transform doc:name\u003d\"Count Outcome\" doc:id\u003d\"b961b6de-9a8b-4d02-821e-55565ebcf7cd\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"sweepCounts\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nvar k \u003d if (vars.sweepCounts[vars.labelOutcome default \"unknown\"] !\u003d null) (vars.labelOutcome default \"unknown\") else \"unknown\"\n---\nvars.sweepCounts mapObject ((v, key) -\u003e { (key): if ((key as String) \u003d\u003d k) v + 1 else v })]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"drxFill\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nnull]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"drxPackingList\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nnull]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/foreach\u003e\r\n\u003cchoice doc:name\u003d\"Live?\" doc:id\u003d\"82073250-027c-40f2-bdce-b063a0aee745\"\u003e\r\n\u003cwhen expression\u003d\"#[!(vars.sweep.dryRun)]\"\u003e\r\n\u003cdb:select doc:name\u003d\"Labels To Retry\" doc:id\u003d\"ae40001a-2c79-4f73-bc21-7057817fe244\" config-ref\u003d\"Database_Config\" target\u003d\"retryRows\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelRetrySelect}]]\u003e\u003c/db:sql\u003e\r\n\u003cdb:input-parameters\u003e\u003c![CDATA[#[{\"max_attempts\": p(\u0027labelSweep.maxAttempts\u0027), \"window_hours\": p(\u0027labelSweep.retryWindowHours\u0027), \"retry_minutes\": p(\u0027labelSweep.retryMinutes\u0027), \"backfill_hours\": p(\u0027labelSweep.backfillHours\u0027)}]]]\u003e\u003c/db:input-parameters\u003e\r\n\u003c/db:select\u003e\r\n\u003cforeach doc:name\u003d\"Retries\" doc:id\u003d\"0cb3b855-6f74-443a-96f4-30606496b161\" collection\u003d\"#[vars.retryRows default []]\"\u003e\r\n\u003cee:transform doc:name\u003d\"Start Retry\" doc:id\u003d\"7c3f68b9-d265-4c43-b350-1208f52d3c14\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nread(payload.payload default \"{}\", \"application/json\")]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"provider\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\npayload.provider_code]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003