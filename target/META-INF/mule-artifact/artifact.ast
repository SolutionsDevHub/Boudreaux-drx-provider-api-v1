:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":12},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":27},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":222},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":222},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":241},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":12},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":98},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":241},"DECLARED_PREFIX":{"type":"java.lang.String","value":"ee"}},"sourceCode":"\u003cee:transform doc:name\u003d\"Failure Record\" doc:id\u003d\"eb2546e5-c571-4f7e-bfaf-23d20d50a2d2\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"labelRecord\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nvar halted \u003d (error.errorType.identifier default \"\") \u003d\u003d \"HALT_FLOW\"\nvar partnerMessage \u003d vars.error.errorMessage\nvar partnerText \u003d if (partnerMessage is String) partnerMessage\n\telse if ((partnerMessage is Object) or (partnerMessage is Array)) write(partnerMessage, \"application/json\", {indent: false})\n\telse \"\"\nvar detail \u003d if (halted) ((vars.error.errorType default \"\") ++ \" \" ++ partnerText)\n\telse ((error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\"))\n---\n{\n\t\"status\": if (halted) \"rejected\" else \"failed\",\n\t\"httpStatus\": null,\n\t\"error\": if (sizeOf(detail) \u003e 300) detail[0 to 299] else detail\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e","startColumn":12,"startLine":222},"parameters":[{"groupModelName":"Message","modelName":"setPayload","value":{},"defaultValue":true},{"groupModelName":"Message","modelName":"set