TE"}},"fileName":"implementation/shipment.xml","line":493,"column":4},{"partPath":"processors"},{"partPath":"1","partIdentifier":{"identifier":{"name":"transform","namespace":"ee","namespaceUri":"http://www.mulesoft.org/schema/mule/ee/core"},"type":{"name":"OPERATION"}},"fileName":"implementation/shipment.xml","line":548,"column":5}],"location":"label-sweep-run-flow/processors/5/route/0/processors/1"},"metadata":{"docAttributes":{"name":"Candidates","id":"0f16dd64-4f28-4d1c-901e-04b57d583d2b"},"endColumn":20,"endLine":576,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":5},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":20},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":548},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":548},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":576},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":5},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":87},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":576},"DECLARED_PREFIX":{"type":"java.lang.String","value":"ee"}},"sourceCode":"\u003cee:transform doc:name\u003d\"Candidates\" doc:id\u003d\"0f16dd64-4f28-4d1c-901e-04b57d583d2b\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"candidateInfo\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nfun epochOf(s) \u003d if ((s is String) and (sizeOf(s) \u003e\u003d 19)) (((s[0 to 18] ++ \"Z\") as DateTime) as Number {unit: \"seconds\"}) else 0\nvar settleS \u003d (now() as Number {unit: \"seconds\"}) - ((vars.sweep.settleMinutes as Number) * 60)\n// DEV only: test labels from config, routed through the real DRX lookups and the real partner call\nvar fixtures \u003d if (vars.sweep.fixture) read(p(\u0027labelSweep.fixtureLabels\u0027), \"application/json\") else []\nvar all \u003d (vars.realLabels ++ fixtures) distinctBy ($.id)\nvar eligible \u003d (all filter ((l) -\u003e ((l.id as Number) \u003e (vars.baseline as Number))\n\tand !(l.voided default false)\n\tand !(isEmpty(l.tracking_number))\n\tand (epochOf(l.created_at) \u003c\u003d settleS))) orderBy ($.id as Number)\nvar capped \u003d if (sizeOf(eligible) \u003e vars.sweep.maxLabels) eligible[0 to (vars.sweep.maxLabels - 1)] else eligible\nvar fixtureIds \u003d fixtures map ($.id as Number)\nvar olderReal \u003d (vars.realLabels filter (epochOf($.created_at) \u003c\u003d settleS)) map ($.id as Number)\nvar cappedReal \u003d (capped map ($.id as Number)) filter ((i) -\u003e !(fixtureIds contains i))\n---\n{\n\tread: sizeOf(vars.realLabels),\n\tfixtures: sizeOf(fixtures),\n\teligible: sizeOf(eligible),\n\tcandidates: capped,\n\t// next run pages back to this id (minus a margin); when capped, only as far as this run got\n\thighWater: if (sizeOf(eligible) \u003e vars.sweep.maxLabels) (max(cappedReal) default vars.highWater) else (max(olderReal) default vars.highWater)\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e","startColumn":5,"startLine":548},"parameters":[{"groupModelName":"Message","modelName":"setPayload","value":{},"defaultValue":true},{"groupModelName":"Message","modelName":"setAttributes","value":{},"defaultValue":true},{"metadata":{"docAttributes":{},"endColumn":21,"endLine":575,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":6},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":21},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":550},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":550},"CLOSING_TAG_START_LINE":{"type":"java.lan