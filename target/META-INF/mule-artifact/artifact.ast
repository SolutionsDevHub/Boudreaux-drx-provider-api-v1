xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":117},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":133},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":133},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":133},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":117},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":133},"IS_SELF_CLOSING":{"type":"java.lang.Boolean","value":true}},"sourceCode":"\u003cflow-ref doc:name\u003d\"deliver-label-flow\" doc:id\u003d\"f100eba9-d5ad-437f-bddc-c3dae8df40ea\" name\u003d\"deliver-label-flow\"\u003e\u003c/flow-ref\u003e","startColumn":3,"startLine":133},"parameters":[{"unresolvedValue":"deliver-label-flow","metadata":{"docAttributes":{"name":"deliver-label-flow","id":"f100eba9-d5ad-437f-bddc-c3dae8df40ea"},"endColumn":117,"endLine":133,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":117},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":133},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":133},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":133},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":117},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":133},"IS_SELF_CLOSING":{"type":"java.lang.Boolean","value":true}},"sourceCode":"\u003cflow-ref doc:name\u003d\"deliver-label-flow\" doc:id\u003d\"f100eba9-d5ad-437f-bddc-c3dae8df40ea\" name\u003d\"deliver-label-flow\"\u003e\u003c/flow-ref\u003e","startColumn":3,"startLine":133},"groupModelName":"General","modelName":"name","value":{"aString":"deliver-label-flow"},"defaultValue":false},{"groupModelName":"Output","modelName":"target","value":{},"defaultValue":true},{"unresolvedValue":"#[payload]","metadata":{"docAttributes":{"name":"deliver-label-flow","id":"f100eba9-d5ad-437f-bddc-c3dae8df40ea"},"endColumn":117,"endLine":133,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":117},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":133},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":133},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":133},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":117},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":133},"IS_SELF_CLOSING":{"type":"java.lang.Boolean","value":true}},"sourceCode":"\u003cflow-ref doc:name\u003d\"deliver-label-flow\" doc:id\u003d\"f100eba9-d5ad-437f-bddc-c3dae8df40ea\" name\u003d\"deliver-label-flow\"\u003e\u003c/flow-ref\u003e","startColumn":3,"startLine":133},"groupModelName":"Output","modelName":"targetValue","value":{"expression":"payload"},"defaultValue":true}],"extensionModel":{"name":"mule"},"modelName":"flowRef","modelType":"OPERATION","annotations":{"{http://www.mulesoft.org/schema/mule/documentation}name":"deliver-label-flow","{http://www.mulesoft.org/schema/mule/documentation}id":"f100eba9-d5ad-437f-bddc-c3dae8df40ea"}}],"componentType":"SUB_FLOW","identifier":{"name":"sub-flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"location":{"name":"create-shipment-flow","parts":[{"partPath":"create-shipment-flow","partIdentifier":{"identifier":{"name":"sub-flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"SUB_FLOW"}},"fileName":"implementation/shipment.xml","line":14,"column":2}],"location":"create-shipment-flow"},"metadata":{"docAttributes":{"id":"135e163a-c2c9-4301-85c1-95514e070c95"},"endColumn":13,"endLine":134,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":13},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":14},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":14},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":134},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":87},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":134}},"sourceCode":"\u003csub-flow name\u003d\"create-shipment-flow\" doc:id\u003d\"135e163a-c2c9-4301-85c1-95514e070c95\"\u003e\r\n\u003cee:transform doc:name\u003d\"Resolve Partner\" doc:id\u003d\"7c2d9e41-5a3b-4f6c-8d1e-2b9a0f4c6e13\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"routing\"\u003e\u003c![CDATA[%dw 2.0\nimport * from dw::core::Strings\noutput application/json\nvar codes \u003d keysOf(vars.connectionDetails default {}) map ($ as String)\nvar fills \u003d payload.fills default []\nvar refs \u003d flatten(fills map ((f) -\u003e [f.external_id, f.prescription.surescripts_erx_id, f.prescription.surescripts_erx_order_number]))\n\tfilter ((r) -\u003e if (r is String) ((r contains \":\") and (codes contains substringBefore(r, \":\"))) else false)\n---\n{\n\tcode: if (isEmpty(refs)) \"\" else substringBefore(refs[0], \":\"),\n\tref: if (isEmpty(refs)) null else substringAfter(refs[0], \":\"),\n\tsource: if (isEmpty(refs)) null else \"prefix\",\n\tprescriptionId: (fills map ((f) -\u003e f.prescription_id default f.prescription.id) filter ($ !\u003d null))[0],\n\tprescriptionIds: (fills map ((f) -\u003e f.prescription_id default f.prescription.id) filter ($ !\u003d null)) map ($ as String) distinctBy $\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Prefix found?\" doc:id\u003d\"b0ae6cb7-f449-4ff1-b744-72f487e178b9\"\u003e\r\n\u003cwhen expression\u003d\"#[isEmpty(vars.routing.code) and (vars.routing.prescriptionId !\u003d null)]\"\u003e\r\n\u003cee:transform doc:name\u003d\"Set Prescription Search Request\" doc:id\u003d\"5b60333c-04c5-462f-8792-2b97d83ac795\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"dbSearch\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\tquery: p(\u0027db.searchWithDRXIdList\u0027),\n\tinputParameters: {\n\t\t\"drx_ids\": (vars.routing.prescriptionIds default []) joinBy \",\",\n\t\t\"entity\": p(\u0027prescription\u0027)\n\t}\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"action\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\np(\u0027retrieve\u0027)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"entity\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\np(\u0027prescription\u0027)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cflow-ref doc:name\u003d\"common-db-search-flow\" doc:id\u003d\"38413901-bf38-478d-b2b4-a150b0cb0f99\" name\u003d\"common-db-search-flow\" target\u003d\"dbSearchResponse\"\u003e\u003c/flow-ref\u003e\r\n\u003cee:transform doc:name\u003d\"Partner From Mapping Table\" doc:id\u003d\"80ffdacb-bf62-42b3-ba84-e883395342a3\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"routing\"\u003e\u003c![CDATA[%dw 2.0\nimport * from dw::core::Strings\noutput application/json\nvar rows \u003d vars.dbSearchResponse default []\nvar code \u003d rows[0].provider_code default \"\"\n// provider_external_id is the partner\u0027s own id; external_id is only the row key\nfun extOf(row) \u003d if (isEmpty(row.provider_external_id)) row.external_id else row.provider_external_id\nfun refOf(row) \u003d do {\n\tvar ext \u003d extOf(row)\n\t---\n\tif (ext is String) (if (ext startsWith (code ++ \":\")) substringAfter(ext, \":\") else ext) else ext\n}\nvar mine \u003d rows filter ((r) -\u003e r.provider_code \u003d\u003d code)\n---\n{\n\tcode: code,\n\tref: if (isEmpty(mine)) null else refOf(mine[0]),\n\tsource: if (isEmpty(code)) null else \"db\",\n\tprescriptionId: vars.routing.prescriptionId,\n\t// the partner\u0027s order id for each of its prescriptions on this label\n\trefsByRx: {( mine map ((r) -\u003e { ((r.drx_id default \"\") as String): refOf(r) }) )}\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003cee:transform doc:name\u003d\"Set Request Variables From Routing\" doc:id\u003d\"6924ea0c-d32d-4d2b-b546-007305fe7592\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"request\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nif (isEmpty(vars.routing.code)) null else vars.connectionDetails[vars.routing.code]]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"entity\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n\"shipment\"]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"externalId\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nvars.routing.ref]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"id\"\u003e\u003c![CDATA[%dw 