rs.provider \u003d\u003d \"WLM\") \"STATUS_NOT_SENT_TO_PARTNER\" else \"NO_WEBHOOK_URL\",\n\t\"provider\": if (isEmpty(vars.provider)) null else vars.provider,\n\t\"id\": vars.id\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"httpStatus\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n200]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Ignored\" doc:id\u003d\"b80c051d-3b7b-49eb-bb84-fda743d7907c\" message\u003d\"#[%dw 2.0\noutput application/json\n---\npayload]\"\u003e\u003c/logger\u003e\r\n\u003c/otherwise\u003e","startColumn":4,"startLine":167},"parameters":[],"extensionModel":{"name":"mule"},"modelName":"otherwise","modelType":"NESTED_ROUTE","annotations":{}}],"componentType":"ROUTER","identifier":{"name":"choice","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"location":{"name":"create-prescription-fill-status-flow","parts":[{"partPath":"create-prescription-fill-status-flow","partIdentifier":{"identifier":{"name":"sub-flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"SUB_FLOW"}},"fileName":"implementation/prescription-fill.xml","line":8,"column":2},{"partPath":"processors"},{"partPath":"6","partIdentifier":{"identifier":{"name":"choice","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ROUTER"}},"fileName":"implementation/prescription-fill.xml","line":161,"column":3}],"location":"create-prescription-fill-status-flow/processors/6"},"metadata":{"docAttributes":{"name":"Choice","id":"45676288-4a97-4b00-9406-1284f4e9d36b"},"endColumn":12,"endLine":190,"fileName":"implementation/prescription-fill.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/prescription-fill.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":12},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":161},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":161},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":190},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":76},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":190}},"sourceCode":"\u003cchoice doc:name\u003d\"Choice\" doc:id\u003d\"45676288-4a97-4b00-9406-1284f4e9d36b\"\u003e\r\n\u003cwhen expression\u003d\"#[!isEmpty(vars.request.url)]\"\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Provider Information\" doc:id\u003d\"b5a3ac9b-8e55-49a5-8a8f-6dd0ad59e12d\" message\u003d\"#[%dw 2.0\noutput application/json\n---\n{\n \"messages\" : \"Posting prescription-fill status to provider\",\n \"provider\":  vars.provider,\n \"fill_id\": vars.id,\n \"status\": payload.status\n}]\"\u003e\u003c/logger\u003e\r\n\u003cflow-ref doc:name\u003d\"common-request-flow\" doc:id\u003d\"03279ec9-8a69-46fe-ab67-c28356c8539b\" name\u003d\"common-request-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cset-payload value\u003d\"#[%dw 2.0\noutput application/json\n---\npayload]\" doc:name\u003d\"Set Prescription Fill Output Response\" doc:id\u003d\"f172d0bf-c915-4e83-b452-0eb5fee29280\"\u003e\u003c/set-payload\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003cee:transform doc:name\u003d\"Set Ignored Response\" doc:id\u003d\"b1b99ca3-936c-4022-8b2b-bdfc761d2359\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\t\"status\": \"Ignored\",\n\t\"reason_code\": if (isEmpty(vars.provider)) \"NOT_A_PARTNER_ORDER\" else if (vars.provider \u003d\u003d \"WLM\") \"STATUS_NOT_SENT_TO_PARTNER\" else \"NO_WEBHOOK_URL\",\n\t\"provider\": if (isEmpty(vars.provider)) null else vars.provider,\n\t\"id\": vars.id\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"httpStatus\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n200]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Ignored\" doc:id\u003d\"b80c051d-3b7b-49eb-bb84-fda743d7907c\" message\u003d\"#[%dw 2.0\noutput application/json\n---\npayload]\"\u003e\u003c/logger\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e","startColumn":3,"startLine":161},"parameters":[{"groupModelName":"Business Events","modelName":"enableDefaultEvents","value":{"aBoolean":false},"defaultValue":true},{"groupModelName":"Output","modelName":"target","value":{},"defaultValue":true},{"groupModelName":"Output","modelName":"targetValue","value":{"expression":"payload"},"defaultValue":true},{"groupModelName":"Error Mappings","modelName":"errorMappings","value":{},"defaultValue":true}],"extensionModel":{"name":"mule"},"modelName":"choice","modelType":"OPERATION","annotations":{"{http://www.mulesoft.org/schema/mule/documentation}name":"Choice","{http://www.mulesoft.org/schema/mule/documentation}id":"45676288-4a97-4b00-9406-1284f4e9d36b"}}],"componentType":"SUB_FLOW","identifier":{"name":"sub-flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"location":{"name":"create-prescription-fill-status-flow","parts":[{"partPath":"create-prescription-fill-status-flow","partIdentifier":{"identifier":{"name":"sub-flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"SUB_FLOW"}},"fileName":"implementation/prescription-fill.xml","line":8,"column":2}],"location":"create-prescription-fill-status-flow"},"metadata":{"docAttributes":{"id":"d29eda92-ffa4-4b37-b992-88a775af8103"},"endColumn":13,"endLine":191,"fileName":"implementation/prescription-fill.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/prescription-fill.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":13},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":8},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":8},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":191},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":103},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":191}},"sourceCode":"\u003csub-flow name\u003d\"create-prescription-fill-status-flow\" doc:id\u003d\"d29eda92-ffa4-4b37-b992-88a775af8103\"\u003e\r\n\u003cee:transform doc:name\u003d\"Resolve Partner\" doc:id\u003d\"3f0b6a1e-2c4d-4e8a-9b1f-7d2e5c6a8b01\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"routing\"\u003e\u003c![CDATA[%dw 2.0\nimport * from dw::core::Strings\noutput application/json\nvar codes \u003d keysOf(vars.connectionDetails default {}) map ($ as String)\nvar refs \u003d [payload.external_id, payload.prescription.surescripts_erx_id, payload.prescription.surescripts_erx_order_number]\n\tfilter ((r) -\u003e if (r is String) ((r contains \":\") and (codes contains substringBefore(r, \":\"))) else false)\n---\n{\n\tcode: if (isEmpty(refs)) \"\" else substringBefore(refs[0], \":\"),\n\tref: if (isEmpty(refs)) null else substringAfter(refs[0], \":\"),\n\tsource: if (isEmpty(refs)) null else \"prefix\",\n\tprescriptionId: payload.prescription_id default payload.prescription.id\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Record partner prescription?\" doc:id\u003d\"6b1e4c2a-9d3f-4a7e-8c55-2f0d1e9a7b31\"\u003e\r\n\u003cwhen expression\u003d\"#[(vars.routing.source \u003d\u003d \u0027prefix\u0027) and (vars.routing.prescriptionId !\u003d null)]\"\u003e\r\n\u003ctry doc:name\u003d\"Record Partner Prescription\" doc:id\u003d\"1c7d9e3b-5a2f-4b6e-9d08-3e4f5a6b7c82\"\u003e\r\n\u003cdb:insert doc:name\u003d\"Insert Partner Prescription\" doc:id\u003d\"8e2a4c6d-1f3b-4d5e-a7c9-0b1d2e3f4a56\" config-ref\u003d\"Database_Config\" target\u003d\"recordPartnerResult\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.recordPartnerPrescription}]]\u003e\u003c/db:sql\u003e\r\n\u003cdb:input-parameters\u003e\u003c![CDATA[#[%dw 2.0\noutput application/java\n---\n{\n\texternal_id: vars.routing.code ++ \":\" ++ (vars.routing.ref default \"\") ++ \"#\" ++ (vars.routing.prescriptionId as String),\n\tprovider_external_id: vars.routing.ref default \"\",\n\tprovider: vars.connectionDetails[vars.routing.code].provider default vars.routing.code,\n\tprovider_code: vars.routing.code,\n\tprovider_id: vars.routing.code,\n\tdrx_id: vars.routing.prescriptionId as String,\n\tdrx_id_check: vars.routing.prescriptionId as String\n}]]]\u003e\u003c/db:input-parameters\u003e\r\n\u003c/db:insert\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"false\" logException\u003d\"false\" doc:name\u003d\"Recording is best effort\" doc:id\u003d\"4f6a8b0c-2d4e-4f7a-9b1c-3d5e7f9a1b24\"\u003e\r\n\u003clogger level\u003d\"WARN\" doc:name\u003d\"Could Not Record\" doc:id\u003d\"9a1b3c5d-7e9f-4a2b-8c4d-6e8f0a2b4c68\" message\u003d\"#[\"Could not record partner prescription \" ++ ((vars.routing.prescriptionId default \"\") as String) ++ \": \" ++ (error.description default \"\")]\"\u003e\u003c/logger\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003cchoice doc:name\u003d\"Prefix found?\" doc:id\u003d\"329983d0-c57a-47cd-91bf-2f4cebdc415a\"\u003e\r\n\u003cwhen expression\u003d\"#[isEmpty(vars.routing.code) and (vars.routing.prescriptionId !\u003d null)]\"\u003e\r\n\u003cee:transform doc:name\u003d\"Set Prescription Search Request\" doc:id\u003d\"cf7a3692-2a99-450a-9ceb-98b7b25752e0\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"dbSearch\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\tquery: p(\u0027db.searchWithDRXId\u0027),\n\tinputParameters: {\n\t\t\"drx_id\": (vars.routing.prescriptionId as String),\n\t\t\"entity\": p(\u0027prescription\u0027)\n\t}\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"action\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\np(\u0027retrieve\u0027)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"entity\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\np(\u0027prescription\u0027)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cflow-ref doc:name\u003d\"common-db-search-flow\" doc:id\u003d\"e2a3a532-2d9e-4131-9982-7a1a16244bb5\" name\u003d\"common-db-search-flow\" target\u003d\"dbSearchResponse\"\u003e\u003c/flow-ref\u003e\r\n\u003cee:transform doc:name\u003d\"Partner From Mapping Table\" doc:id\u003d\"10841616-7f12-4eb2-a273-6666868df365\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"routing\"\u003e\u003c![CDATA[%dw 2.0\nimport * from dw::core::Strings\noutput application/json\nvar row \u003d vars.dbSearchResponse[0]\nvar code \u003d row.provider_code default \"\"\n// provider_external_id is the partner\u0027s own id; external_id is only the row key\nvar ext \u003d if (isEmpty(row.provider_external_id)) row.external_id else row.provider_external_id\n---\n{\n\tcode: code,\n\tref: if (ext is String) (if (ext startsWith (code ++ \":\")) substringAfter(ext, \":\") else ext) else ext,\n\tsource: if (isEmpty(code)) null else \"db\",\n\tprescriptionId: vars.routing.prescriptionId\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003cee:transform doc:name\u003d\"Set Request Variables From Routing\" doc:id\u003d\"5fb322e8-a26a-4921-b6a3-43153620543f\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"request\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nif (isEmpty(vars.routing.code)) null else vars.connectionDetails[vars.routing.code]]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"entity\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n\"prescription-fill\"]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"externalId\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nvars.routing.ref]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"id\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\npayload.id]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"provider\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nvars.routing.code]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cee:transform doc:name\u003d\"Set Partner Payload\" doc:id\u003d\"a4e1c7d2-8b3f-4d6a-9e05-3c2b1f7a8d60\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload resource\u003d\"dwl/create-prescription-fill.dwl\"\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cee:transform doc:name\u003d\"Set Request Variables\" doc:id\u003d\"81ba4d9a-79dc-4cae-99df-e1429ec20f39\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"request\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nif (vars.request \u003d\u003d null) null else (vars.provider match {\n\tcase str if str \u003d\u003d \"PMD\" -\u003e vars.request ++ {\n\t\t\"queryParams\": {\n\t\t\t\"event\": if ( (payload.status \u003d\u003d \"Hold\") or (payload.status \u003d\u003d \"Pre-Check\") ) \"prescription_created\" else \"status_change\"\n\t\t}\n\t}\n\t// WellieMD takes only new-order, shipped and delivered: send new orders here, labels go out as \"shipped\"\n\tcase str if str \u003d\u003d \"WLM\" -\u003e if ( (payload.status \u003d\u003d \"Hold\") or (payload.status \u003d\u003d \"Pre-Check\") ) (vars.request ++ {\n\t\t\"uriParams\": {\n\t\t\t\"event\": \"new-order\"\n\t\t}\n\t}) else null\n\telse -\u003e vars.request\n})]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Choice\" doc:id\u003d\"45676288-4a97-4b00-9406-1284f4e9d36b\"\u003e\r\n\u003cwhen expression\u003d\"#[!isEmpty(vars.request.url)]\"\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Provider Information\" doc:id\u003d\"b5a3ac9b-8e55-49a5-8a8f-6dd0ad59e12d\" message\u003d\"#[%dw 2.0\noutput application/json\n---\n{\n \"messages\" : \"Posting prescription-fill status to provider\",\n \"provider\":  vars.provider,\n \"fill_id\": vars.id,\n \"status\": payload.status\n}]\"\u003e\u003c/logger\u003e\r\n\u003cflow-ref doc:name\u003d\"common-request-flow\" doc:id\u003d\"03279ec9-8a69-46fe-ab67-c28356c8539b\" name\u003d\"common-request-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cset-payload value\u003d\"#[%dw 2.0\noutput application/json\n---\npayload]\" doc:name\u003d\"Set Prescription Fill Output Response\" doc:id\u003d\"f172d0bf-c915-4e83-b452-0eb5fee29280\"\u003e\u003c/set-payload\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003cee:transform doc:name\u003d\"Set Ignored Response\" doc:id\u003d\"b1b99ca3-936c-4022-8b2b-bdfc761d2359\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\t\"status\": \"Ignored\",\n\t\"reason_code\": if (isEmpty(vars.provider)) \"NOT_A_PARTNER_ORDER\" else if (vars.provider \u003d\u003d \"WLM\") \"STATUS_NOT_SENT_TO_PARTNER\" else \"NO_WEBHOOK_URL\",\n\t\"provider\": if (isEmpty(vars.provider)) null else vars.provider,\n\t\"id\": vars.id\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"httpStatus\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n200]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Ignored\" doc:id\u003d\"b80c051d-3b7b-49eb-bb84-fda743d7907c\" message\u003d\"#[%dw 2.0\noutput application/json\n---\npayload]\"\u003e\u003c/logger\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e\r\n\u003c/sub-flow\u003e","startColumn":2,"startLine":8},"parameters":[{"unresolvedValue":"create-prescription-fill-status-flow","metadata":{"docAttributes":{"id":"d29eda92-ffa4-4b37-b992-88a775af8103"},"endColumn":13,"endLine":191,"fileName":"implementation/prescription-fill.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/prescription-fill.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":13},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":8},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":8},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":191},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":103},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":191}},"sourceCode":"\u003csub-flow name\u003d\"create-prescription-fill-status-flow\" doc:id\u003d\"d29eda92-ffa4-4b37-b992-88a775af8103\"\u003e\r\n\u003cee:transform doc:name\u003d\"Resolve Partner\" doc:id\u003d\"3f0b6a1e-2c4d-4e8a-9b1f-7d2e5c6a8b01\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"routing\"\u003e\u003c![CDATA[%dw 2.0\nimport * from dw::core::Strings\noutput application/json\nvar codes \u003d keysOf(vars.connectionDetails default {}) map ($ as String)\nvar refs \u003d [payload.external_id, payload.prescription.surescripts_erx_id, payload.prescription.surescripts_erx_order_number]\n\tfilter ((r) -\u003e if (r is String) ((r contains \":\") and (codes contains substringBefore(r, \":\"))) else false)\n---\n{\n\tcode: if (isEmpty(refs)) \"\" else substringBefore(refs[0], \":\"),\n\tref: if (isEmpty(refs)) null else substringAfter(refs[0], \":\"),\n\tsource: if (isEmpty(refs)) null else \"prefix\",\n\tprescriptionId: payload.prescription_id default payload.prescription.id\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Record partner prescription?\" doc:id\u003d\"6b1e4c2a-9d3f-4a7e-8c55-2f0d1e9a7b31\"\u003e\r\n\u003cwhen expression\u003d\"#[(vars.routing.source \u003d\u003d \u0027prefix\u0027) and (vars.routing.prescriptionId !\u003d null)]\"\u003e\r\n\u003ctry doc:name\u003d\"Record Partner Prescription\" doc:id\u003d\"1c7d9e3b-5a2f-4b6e-9d08-3e4f5a6b7c82\"\u003e\r\n\u003cdb:insert doc:name\u003d\"Insert Partner Prescription\" doc:id\u003d\"8e2a4c6d-1f3b-4d5e-a7c9-0b1d2e3f4a56\" config-ref\u003d\"Database_Config\" target\u003d\"recordPartnerResult\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.recordPartnerPrescription}]]\u003e\u003c/db:sql\u003e\r\n\u003cdb:input-parameters\u003e\u003c![CDATA[#[%dw 2.0\noutput application/java\n---\n{\n\texternal_id: vars.routing.code ++ \":\" ++ (vars.routing.ref default \"\") ++ \"#\" ++ (vars.routing.prescriptionId as String),\n\tprovider_external_id: vars.routing.ref default \"\",\n\tprovider: vars.connectionDetails[vars.routing.code].provider default vars.routing.code,\n\tprovider_code: vars.routing.code,\n\tprovider_id: vars.routing.code,\n\tdrx_id: vars.routing.prescriptionId as String,\n\tdrx_id_check: vars.routing.prescriptionId as String\n}]]]\u003e\u003c/db:input-parameters\u003e\r\n\u003c/db:insert\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-continue enableNotifications\u003d\"false\" logException\u003d\"false\" doc:name\u003d\"Recording is best effort\" doc:id\u003d\"4f6a8b0c-2d4e-4f7a-9b1c-3d5e7f9a1b24\"\u003e\r\n\u003clogger level\u003d\"WARN\" doc:name\u003d\"Could Not Record\" doc:id\u003d\"9a1b3c5d-7e9f-4a2b-8c4d-6e8f0a2b4c68\" message\u003d\"#[\"Could not record partner prescription \" ++ ((vars.routing.prescriptionId default \"\") as String) ++ \": \" ++ (error.description default \"\")]\"\u003e\u003c/logger\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003cchoice doc:name\u003d\"Prefix found?\" doc:id\u003d\"329983d0-c57a-47cd-91bf-2f4cebdc415a\"\u003e\r\n\u003cwhen expression\u003d\"#[isEmpty(vars.routing.code) and (vars.routing.prescriptionId !\u003d null)]\"\u003e\r\n\u003cee:transform doc:name\u003d\"Set Prescription Search Request\" doc:id\u003d\"cf7a3692-2a99-450a-9ceb-98b7b25752e0\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"dbSearch\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\tquery: p(\u0027db.searchWithDRXId\u0027),\n\tinputParameters: {\n\t\t\"drx_id\": (vars.routing.prescriptionId as String),\n\t\t\"entity\": p(\u0027prescription\u0027)\n\t}\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"action\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\np(\u0027retrieve\u0027)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"entity\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\np(\u0027prescription\u0027)]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cflow-ref doc:name\u003d\"common-db-search-flow\" doc:id\u003d\"e2a3a532-2d9e-4131-9982-7a1a16244bb5\" name\u003d\"common-db-search-flow\" target\u003d\"dbSearchResponse\"\u003e\u003c/flow-ref\u003e\r\n\u003cee:transform doc:name\u003d\"Partner From Mapping Table\" doc:id\u003d\"10841616-7f12-4eb2-a273-6666868df365\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"routing\"\u003e\u003c![CDATA[%dw 2.0\nimport * from dw::core::Strings\noutput application/json\nvar row \u003d vars.dbSearchResponse[0]\nvar code \u003d row.provider_code default \"\"\n// provider_external_id is the partner\u0027s own id; external_id is only the row key\nvar ext \u003d if (isEmpty(row.provider_external_id)) row.external_id else row.provider_external_id\n---\n{\n\tcode: code,\n\tref: if (ext is String) (if (ext startsWith (code ++ \":\")) substringAfter(ext, \":\") else ext) else ext,\n\tsource: if (isEmpty(code)) null else \"db\",\n\tprescriptionId: vars.routing.prescriptionId\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003cee:transform doc:name\u003d\"Set Request Variables From Routing\" doc:id\u003d\"5fb322e8-a26a-4921-b6a3-43153620543f\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"request\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nif (isEmpty(vars.routing.code)) null else vars.connectionDetails[vars.routing.code]]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"entity\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n\"prescription-fill\"]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"externalId\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nvars.routing.ref]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"id\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\npayload.id]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"provider\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nvars.routing.code]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cee:transform doc:name\u003d\"Set Partner Payload\" doc:id\u003d\"a4e1c7d2-8b3f-4d6a-9e05-3c2b1f7a8d60\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload resource\u003d\"dwl/create-prescription-fill.dwl\"\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cee:transform doc:name\u003d\"Set Request Variables\" doc:id\u003d\"81ba4d9a-79dc-4cae-99df-e1429ec20f39\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"request\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nif (vars.request \u003d\u003d null) null else (vars.provider match {\n\tcase str if str \u003d\u003d \"PMD\" -\u003e vars.request ++ {\n\t\t\"queryParams\": {\n\t\t\t\"event\": if ( (payload.status \u003d\u003d \"Hold\") or (payload.status \u003d\u003d \"Pre-Check\") ) \"prescription_created\" else \"status_change\"\n\t\t}\n\t}\n\t// WellieMD takes only new-order, shipped and delivered: send new orders here, labels go out as \"shipped\"\n\tcase str if str \u003d\u003d \"WLM\" -\u003e if ( (payload.status \u003d\u003d \"Hold\") or (payload.status \u003d\u003d \"Pre-Check\") ) (vars.request ++ {\n\t\t\"uriParams\": {\n\t\t\t\"event\": \"new-order\"\n\t\t}\n\t}) else null\n\telse -\u003e vars.request\n})]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Choice\" doc:id\u003d\"45676288-4a97-4b00-9406-1284f4e9d36b\"\u003e\r\n\u003cwhen expression\u003d\"#[!isEmpty(vars.request.url)]\"\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Provider Information\" doc:id\u003d\"b5a3ac9b-8e55-49a5-8a8f-6dd0ad59e12d\" message\u003d\"#[%dw 2.0\noutput application/json\n---\n{\n \"messages\" : \"Posting prescription-fill status to provider\",\n \"provider\":  vars.provider,\n \"fill_id\": vars.id,\n \"status\": payload.status\n}]\"\u003e\u003c/logger\u003e\r\n\u003cflow-ref doc:name\u003d\"common-request-flow\" doc:id\u003d\"03279ec9-8a69-46fe-ab67-c28356c8539b\" name\u003d\"common-request-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cset-payload value\u003d\"#[%dw 2.0\noutput application/json\n---\npayload]\" doc:name\u003d\"Set Prescription Fill Output Response\" doc:id\u003d\"f172d0bf-c915-4e83-b452-0eb5fee29280\"\u003e\u003c/set-payload\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003cee:transform doc:name\u003d\"Set Ignored Response\" doc:id\u003d\"b1b99ca3-936c-4022-8b2b-bdfc761d2359\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\t\"status\": \"Ignored\",\n\t\"reason_code\": if (isEmpty(vars.provider)) \"NOT_A_PARTNER_ORDER\" else if (vars.provider \u003d\u003d \"WLM\") \"STATUS_NOT_SENT_TO_PARTNER\" else \"NO_WEBHOOK_URL\",\n\t\"provider\": if (isEmpty(vars.provider)) null else vars.provider,\n\t\"id\": vars.id\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"httpStatus\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n200]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Ignored\" doc:id\u003d\"b80c051d-3b7b-49eb-bb84-fda743d7907c\" message\u003d\"#[%dw 2.0\noutput application/json\n---\npayload]\"\u003e\u003c/logger\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e\r\n\u003c/sub-flow\u003e","startColumn":2,"startLine":8},"groupModelName":"General","modelName":"name","value":{"aString":"create-prescription-fill-status-flow"},"defaultValue":false}],"componentId":"create-prescription-fill-status-flow","extensionModel":{"name":"mule"},"modelName":"subFlow","modelType":"CONSTRUCT","annotations":{"{http://www.mulesoft.org/schema/mule/documentation}id":"d29eda92-ffa4-4b37-b992-88a775af8103"}}],"errorTypeRepository":{"hierarchy":[{"identifier":"ANY","namespace":"MULE","internal":false,"children":[{"identifier":"SERVER_ERROR","namespace":"OUTLOOK365","internal":false,"children":[]},{"identifier":"CONNECTIVITY","namespace":"MULE","internal":false,"children":[{"identifier":"CONNECTIVITY","namespace":"SOCKETS","internal":false,"children":[{"identifier":"CONNECTION_TIMEOUT","namespace":"SOCKETS","internal":false,"children":[]},{"identifier":"UNKNOWN_HOST","namespace":"SOCKETS","internal":false,"children":[]}]},{"identifier":"CONNECTIVITY","namespace":"ANYPOINT-MQ","internal":false,"children":[]},{"identifier":"RETRY_EXHAUSTED","namespace":"MULE","internal":false,"children":[{"identifier":"RETRY_EXHAUSTED","namespace":"OUTLOOK365","internal":false,"children":[]},{"identifier":"RETRY_EXHAUSTED","namespace":"ANYPOINT-MQ","internal":false,"children":[]},{"identifier":"RETRY_EXHAUSTED","namespace":"APIKIT","internal":false,"children":[]},{"identifier":"RETRY_EXHAUSTED","namespace":"EE","internal":false,"children":[]},{"identifier":"RETRY_EXHAUSTED","namespace":"SOCKETS","internal":false,"children":[]},{"identifier":"RETRY_EXHAUSTED","namespace":"HTTP","internal":false,"children":[]},{"identifier":"RETRY_EXHAUSTED","namespace":"DB","internal":false,"children":[]}]},{"identifier":"CONNECTIVITY","namespace":"HTTP","internal":false,"children":[]},{"identifier":"CONNECTIVITY","namespace":"APIKIT","internal":false,"children":[]},{"identifier":"CONNECTIVITY","namespace":"EE","internal":false,"children":[]},{"identifier":"CONNECTIVITY","namespace":"OUTLOOK365","internal":false,"children":[]},{"identifier":"CONNECTIVITY","namespace":"DB","intern