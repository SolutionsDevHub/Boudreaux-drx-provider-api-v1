()]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"path\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nattributes.requestPath]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"method\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nattributes.method]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"appName\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\napp.name]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Start Logger\" doc:id\u003d\"df2bd92d-ab91-447e-b2b7-c120f220af16\" message\u003d\"#[%dw 2.0\noutput application/json\n---\n{\n \"Event\": \"START\",\n \"CorrelationId\": vars.correlationId,\n \"Application\": vars.appName,\n \"Method\": vars.method,\n \"Path\": vars.path,\n \"Provider\": vars.provider default \"N/A\",\n \"Timestamp\": vars.startTime\n}]\"\u003e\u003c/logger\u003e\r\n\u003capikit:router config-ref\u003d\"drx-provider-api-config\"\u003e\u003c/apikit:router\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"End Logger\" doc:id\u003d\"4160c37d-2238-42ef-8cba-bd690bda1135\" message\u003d\"#[%dw 2.0\noutput application/json\n---\n{\n \"Event\": \"END\",\n \"CorrelationId\": vars.correlationId,\n \"Application\": vars.appName,\n \"Method\": vars.method,\n \"Path\": vars.path,\n \"Provider\": vars.provider default \"N/A\",\n \"ProcessingTime(s)\": (now() - vars.startTime).seconds,\n \"Timestamp\": now()\n}]\"\u003e\u003c/logger\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-propagate type\u003d\"APIKIT:BAD_REQUEST\"\u003e\r\n\u003cee:transform doc:name\u003d\"Create Error Payload\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{message: \"Bad request\"}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u