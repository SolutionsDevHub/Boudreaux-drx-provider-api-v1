" doc:id\u003d\"27d51062-3cce-4331-922d-42fc9f47f67f\"\u003e\r\n\u003cwhen expression\u003d\"#[vars.request !\u003d null and !isEmpty(vars.request.url)]\"\u003e\r\n\u003cchoice doc:name\u003d\"Dry Run?\" doc:id\u003d\"009c5bf8-66a8-400e-8212-536491b72367\"\u003e\r\n\u003cwhen expression\u003d\"#[vars.labelSource \u003d\u003d \u0027sweep\u0027 and (vars.labelDryRun default false)]\"\u003e\r\n\u003cset-variable variableName\u003d\"labelRecord\" value\u003d\"#[{\"status\": \"dry_run\", \"provider\": vars.provider, \"error\": null, \"withPayload\": true}]\" doc:name\u003d\"Dry Run Record\" doc:id\u003d\"c33d1425-4e3d-40da-873f-806363404f4c\"\u003e\u003c/set-variable\u003e\r\n\u003cflow-ref doc:name\u003d\"label-record-flow\" doc:id\u003d\"d364c5cf-46e2-43b0-8633-5b3a2eee0d9a\" name\u003d\"label-record-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Dry Run\" doc:id\u003d\"73974a6c-a45e-4fbc-bc88-845a4a7c2571\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL SWEEP DRY RUN\", \"messages\": \"Would send this shipping label to the partner (dry run: nothing sent)\", \"provider\": vars.provider, \"shipment_id\": vars.shipmentNumber}]\"\u003e\u003c/logger\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"dry_run\" doc:name\u003d\"Outcome Dry Run\" doc:id\u003d\"635e57c3-0d4b-4a21-bbf7-c232fd28eb98\"\u003e\u003c/set-variable\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003cflow-ref doc:name\u003d\"label-claim-flow\" doc:id\u003d\"5f347c21-b0d8-4950-ac9c-420424f731ee\" name\u003d\"label-claim-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cchoice doc:name\u003d\"Claimed?\" doc:id\u003d\"5b9b4d8e-9e2a-4bc6-a845-d9a57a400483\"\u003e\r\n\u003cwhen expression\u003d\"#[!(vars.labelClaimed default true)]\"\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Already Delivered\" doc:id\u003d\"9fab1c28-40b3-49bf-ab6e-83990e64a533\" message\u003d\"#[output application/json --- {\"messages\": \"Shipping label already delivered to this partner (or being sent); not sent again\", \"provider\": vars.provider, \"shipment_id\": vars.shipmentNumber, \"source\": vars.labelSource}]\"\u003e\u003c/logger\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"already\" doc:name\u003d\"Outcome Already\" doc:id\u003d\"fa8f4c83-0638-486b-ba57-4ed02d3e5525\"\u003e\u003c/set-variable\u003e\r\n\u003cee:transform doc:name\u003d\"Set Already Delivered Response\" doc:id\u003d\"62920304-0177-43fe-bc2d-f00f09e86044\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\t\"status\": \"AlreadyDelivered\",\n\t\"provider\": vars.provider,\n\t\"shipmentId\": vars.shipmentNumber\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"httpStatus\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n200]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Provider Information\" doc:id\u003d\"c960a0ba-99c9-4978-bb50-4fe183470bb6\" message\u003d\"#[%dw 2.0\noutput application/json\n---\n{\n \"messages\" : \"Posting shipment information to provider\",\n \"provider\":  vars.provider,\n \"shipment_id\": vars.shipmentNumber,\n \"source\": vars.labelSource\n}]\"\u003e\u003c/logger\u003e\r\n\u003ctry doc:name\u003d\"Send Label\" doc:id\u003d\"b4789524-fc30-4325-a072-70799a43f71f\"\u003e\r\n\u003cset-variable variableName\u003d\"haltFlow\" value\u003d\"#[false]\" doc:name\u003d\"Reset Halt Flag\" doc:id\u003d\"574da05f-a8d2-4001-9ab4-4ee068a2f989\"\u003e\u003c/set-variable\u003e\r\n\u003cflow-ref doc:name\u003d\"common-request-flow\" doc:id\u003d\"2944e15e-08d3-4b6d-9e98-01c6bf380e19\" name\u003d\"common-request-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cset-variable variableName\u003d\"labelRecord\" value\u003d\"#[{\"status\": \"sent\", \"httpStatus\": attributes.statusCode default null, \"error\": null}]\" doc:name\u003d\"Sent Record\" doc:id\u003d\"f23a24b5-9fe1-4c59-ac33-ff16f4906920\"\u003e\u003c/set-variable\u003e\r\n\u003cflow-ref doc:name\u003d\"label-mark-flow\" doc:id\u003d\"a46d4521-c95a-48f5-84bc-398e3f7a8a0f\" name\u003d\"label-mark-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"sent\" doc:name\u003d\"Outcome Sent\" doc:id\u003d\"b3bb13ab-fbde-4bd8-b693-2975df6170d0\"\u003e\u003c/set-variable\u003e\r\n\u003cset-payload value\u003d\"#[%dw 2.0\noutput application/json\n---\npayload]\" doc:name\u003d\"Set Shipment Output Response\" doc:id\u003d\"b5dc2139-5da7-4c4e-a21c-bd07360fe0a6\"\u003e\u003c/set-payload\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-propagate enableNotifications\u003d\"true\" logException\u003d\"true\" doc:name\u003d\"Record Failure\" doc:id\u003d\"89480c19-02e3-4f47-b079-202cac0ebf05\"\u003e\r\n\u003cee:transform doc:name\u003d\"Failure Record\" doc:id\u003d\"eb2546e5-c571-4f7e-bfaf-23d20d50a2d2\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"labelRecord\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nvar halted \u003d (error.errorType.identifier default \"\") \u003d\u003d \"HALT_FLOW\"\nvar partnerMessage \u003d vars.error.errorMessage\nvar partnerText \u003d if (partnerMessage is String) partnerMessage\n\telse if ((partnerMessage is Object) or (partnerMessage is Array)) write(partnerMessage, \"application/json\", {indent: false})\n\telse \"\"\nvar detail \u003d if (halted) ((vars.error.errorType default \"\") ++ \" \" ++ partnerText)\n\telse ((error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\"))\n---\n{\n\t\"status\": if (halted) \"rejected\" else \"failed\",\n\t\"httpStatus\": null,\n\t\"error\": if (sizeOf(detail) \u003e 300) detail[0 to 299] else detail\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cflow-ref doc:name\u003d\"label-mark-flow\" doc:id\u003d\"5f66ff0e-c3d0-4d47-b243-2c67725118c2\" name\u003d\"label-mark-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"#[vars.labelRecord.status]\" doc:name\u003d\"Outcome Failed\" doc:id\u003d\"9948b569-be4c-4eb4-9530-3a718049f139\"\u003e\u003c/set-variable\u003e\r\n\u003c/on-error-propagate\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003cee:transform doc:name\u003d\"Set Ignored Response\" doc:id\u003d\"63275fff-d396-4017-a3cc-e0b1a54c3f48\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\t\"status\": \"Ignored\",\n\t\"reason_code\": if (isEmpty(vars.provider)) \"NOT_A_PARTNER_ORDER\" else \"NO_WEBHOOK_URL\",\n\t\"provider\": if (isEmpty(vars.provider)) null else vars.provider,\n\t\"shipmentId\": vars.shipmentNumber\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"httpStatus\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n200]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Ignored\" doc:id\u003d\"92f3ec1a-731b-4132-87a9-26eedf933bb6\" message\u003d\"#[%dw 2.0\noutput application/json\n---\npayload]\"\u003e\u003c/logger\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"#[if (isEmpty(vars.provider)) \"not_partner\" else \"no_webhook_url\"]\" doc:name\u003d\"Outcome Ignored\" doc:id\u003d\"df6d08e1-dbc3-4728-9c0f-3799a7f17724\"\u003e\u003c/set-variable\u003e\r\n\u003cchoice doc:name\u003d\"Sweep?\" doc:id\u003d\"c102fcd8-db60-4181-a759-22403509c0d0\"\u003e\r\n\u003cwhen expression\u003d\"#[vars.labelSource \u003d\u003d \u0027sweep\u0027]\"\u003e\r\n\u003cset-variable variableName\u003d\"labelRecord\" value\u003d\"#[{\"status\": vars.labelOutcome, \"provider\": (if (isEmpty(vars.provider)) \"-\" else vars.provider), \"error\": null, \"withPayload\": false}]\" doc:name\u003d\"Ignored Record\" doc:id\u003d\"8f22e681-d4dc-433c-a163-d6ed310952c6\"\u003e\u003c/set-variable\u003e\r\n\u003cflow-ref doc:name\u003d\"label-record-flow\" doc:id\u003d\"6d4fbcbf-0e31-46d6-833c-85d71c647c83\" name\u003d\"label-record-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e","startColumn":3,"startLine":175},"parameters":[{"groupModelName":"Business Events","modelName":"enableDefaultEvents","value":{"aBoolean":false},"defaultValue":true},{"groupModelName":"Output","modelName":"target","value":{},"defaultValue":true},{"groupModelName":"Output","modelName":"targetValue","value":{"expression":"payload"},"defaultValue":true},{"groupModelName":"Error Mappings","modelName":"errorMappings","value":{},"defaultValue":true}],"extensionModel":{"name":"mule"},"modelName":"choice","modelType":"OPERATION","annotations":{"{http://www.mulesoft.org/schema/mule/documentation}name":"Partner Webhook?","{http://www.mulesoft.org/schema/mule/documentation}id":"27d51062-3cce-4331-922d-42fc9f47f67f"}}],"componentType":"SUB_FLOW","identifier":{"name":"sub-flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"location":{"name":"deliver-label-flow","parts":[{"partPath":"deliver-label-flow","partIdentifier":{"identifier":{"name":"sub-flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"SUB_FLOW"}},"fileName":"implementation/shipment.xml","line":139,"column":2}],"location":"deliver-label-flow"},"metadata":{"docAttributes":{"id":"6ad9a1e9-722f-4c2b-8b42-610ce8c92fa8"},"endColumn":13,"endLine":284,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":13},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":139},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":139},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":284},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":84},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":284}},"sourceCode":"\u003csub-flow name\u003d\"deliver-label-flow\" doc:id\u003d\"6ad9a1e9-722f-4c2b-8b42-610ce8c92fa8\"\u003e\r\n\u003cee:transform doc:name\u003d\"Set Partner Request\" doc:id\u003d\"6aa56fe1-7f4f-456e-8506-89b758ba55a5\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"request\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\nvar base \u003d if (isEmpty(vars.provider)) null else vars.connectionDetails[vars.provider]\n---\nif (base \u003d\u003d null) null else (vars.provider match {\n\tcase \"PMD\" -\u003e base ++ {\n\t\t\"queryParams\": {\n\t\t\t\"event\": \"shipping_label\"\n\t\t}\n\t}\n\tcase \"WLM\" -\u003e base ++ {\n\t\t\"uriParams\": {\n\t\t\t\"event\": \"shipped\"\n\t\t}\n\t}\n\telse -\u003e base\n})]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"labelSource\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nvars.labelSource default \"webhook\"]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"entity\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n\"shipment\"]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"labelBody\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nwrite(payload, \"application/json\", {indent: false})]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Partner Webhook?\" doc:id\u003d\"27d51062-3cce-4331-922d-42fc9f47f67f\"\u003e\r\n\u003cwhen expression\u003d\"#[vars.request !\u003d null and !isEmpty(vars.request.url)]\"\u003e\r\n\u003cchoice doc:name\u003d\"Dry Run?\" doc:id\u003d\"009c5bf8-66a8-400e-8212-536491b72367\"\u003e\r\n\u003cwhen expression\u003d\"#[vars.labelSource \u003d\u003d \u0027sweep\u0027 and (vars.labelDryRun default false)]\"\u003e\r\n\u003cset-variable variableName\u003d\"labelRecord\" value\u003d\"#[{\"status\": \"dry_run\", \"provider\": vars.provider, \"error\": null, \"withPayload\": true}]\" doc:name\u003d\"Dry Run Record\" doc:id\u003d\"c33d1425-4e3d-40da-873f-806363404f4c\"\u003e\u003c/set-variable\u003e\r\n\u003cflow-ref doc:name\u003d\"label-record-flow\" doc:id\u003d\"d364c5cf-46e2-43b0-8633-5b3a2eee0d9a\" name\u003d\"label-record-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Dry Run\" doc:id\u003d\"73974a6c-a45e-4fbc-bc88-845a4a7c2571\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL SWEEP DRY RUN\", \"messages\": \"Would send this shipping label to the partner (dry run: nothing sent)\", \"provider\": vars.provider, \"shipment_id\": vars.shipmentNumber}]\"\u003e\u003c/logger\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"dry_run\" doc:name\u003d\"Outcome Dry Run\" doc:id\u003d\"635e57c3-0d4b-4a21-bbf7-c232fd28eb98\"\u003e\u003c/set-variable\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003cflow-ref doc:name\u003d\"label-claim-flow\" doc:id\u003d\"5f347c21-b0d8-4950-ac9c-420424f731ee\" name\u003d\"label-claim-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cchoice doc:name\u003d\"Claimed?\" doc:id\u003d\"5b9b4d8e-9e2a-4bc6-a845-d9a57a400483\"\u003e\r\n\u003cwhen expression\u003d\"#[!(vars.labelClaimed default true)]\"\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Already Delivered\" doc:id\u003d\"9fab1c28-40b3-49bf-ab6e-83990e64a533\" message\u003d\"#[output application/json --- {\"messages\": \"Shipping label already delivered to this partner (or being sent); not sent again\", \"provider\": vars.provider, \"shipment_id\": vars.shipmentNumber, \"source\": vars.labelSource}]\"\u003e\u003c/logger\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"already\" doc:name\u003d\"Outcome Already\" doc:id\u003d\"fa8f4c83-0638-486b-ba57-4ed02d3e5525\"\u003e\u003c/set-variable\u003e\r\n\u003cee:transform doc:name\u003d\"Set Already Delivered Response\" doc:id\u003d\"62920304-0177-43fe-bc2d-f00f09e86044\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\t\"status\": \"AlreadyDelivered\",\n\t\"provider\": vars.provider,\n\t\"shipmentId\": vars.shipmentNumber\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"httpStatus\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n200]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Provider Information\" doc:id\u003d\"c960a0ba-99c9-4978-bb50-4fe183470bb6\" message\u003d\"#[%dw 2.0\noutput application/json\n---\n{\n \"messages\" : \"Posting shipment information to provider\",\n \"provider\":  vars.provider,\n \"shipment_id\": vars.shipmentNumber,\n \"source\": vars.labelSource\n}]\"\u003e\u003c/logger\u003e\r\n\u003ctry doc:name\u003d\"Send Label\" doc:id\u003d\"b4789524-fc30-4325-a072-70799a43f71f\"\u003e\r\n\u003cset-variable variableName\u003d\"haltFlow\" value\u003d\"#[false]\" doc:name\u003d\"Reset Halt Flag\" doc:id\u003d\"574da05f-a8d2-4001-9ab4-4ee068a2f989\"\u003e\u003c/set-variable\u003e\r\n\u003cflow-ref doc:name\u003d\"common-request-flow\" doc:id\u003d\"2944e15e-08d3-4b6d-9e98-01c6bf380e19\" name\u003d\"common-request-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cset-variable variableName\u003d\"labelRecord\" value\u003d\"#[{\"status\": \"sent\", \"httpStatus\": attributes.statusCode default null, \"error\": null}]\" doc:name\u003d\"Sent Record\" doc:id\u003d\"f23a24b5-9fe1-4c59-ac33-ff16f4906920\"\u003e\u003c/set-variable\u003e\r\n\u003cflow-ref doc:name\u003d\"label-mark-flow\" doc:id\u003d\"a46d4521-c95a-48f5-84bc-398e3f7a8a0f\" name\u003d\"label-mark-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"sent\" doc:name\u003d\"Outcome Sent\" doc:id\u003d\"b3bb13ab-fbde-4bd8-b693-2975df6170d0\"\u003e\u003c/set-variable\u003e\r\n\u003cset-payload value\u003d\"#[%dw 2.0\noutput application/json\n---\npayload]\" doc:name\u003d\"Set Shipment Output Response\" doc:id\u003d\"b5dc2139-5da7-4c4e-a21c-bd07360fe0a6\"\u003e\u003c/set-payload\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-propagate enableNotifications\u003d\"true\" logException\u003d\"true\" doc:name\u003d\"Record Failure\" doc:id\u003d\"89480c19-02e3-4f47-b079-202cac0ebf05\"\u003e\r\n\u003cee:transform doc:name\u003d\"Failure Record\" doc:id\u003d\"eb2546e5-c571-4f7e-bfaf-23d20d50a2d2\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"labelRecord\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nvar halted \u003d (error.errorType.identifier default \"\") \u003d\u003d \"HALT_FLOW\"\nvar partnerMessage \u003d vars.error.errorMessage\nvar partnerText \u003d if (partnerMessage is String) partnerMessage\n\telse if ((partnerMessage is Object) or (partnerMessage is Array)) write(partnerMessage, \"application/json\", {indent: false})\n\telse \"\"\nvar detail \u003d if (halted) ((vars.error.errorType default \"\") ++ \" \" ++ partnerText)\n\telse ((error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\"))\n---\n{\n\t\"status\": if (halted) \"rejected\" else \"failed\",\n\t\"httpStatus\": null,\n\t\"error\": if (sizeOf(detail) \u003e 300) detail[0 to 299] else detail\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cflow-ref doc:name\u003d\"label-mark-flow\" doc:id\u003d\"5f66ff0e-c3d0-4d47-b243-2c67725118c2\" name\u003d\"label-mark-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"#[vars.labelRecord.status]\" doc:name\u003d\"Outcome Failed\" doc:id\u003d\"9948b569-be4c-4eb4-9530-3a718049f139\"\u003e\u003c/set-variable\u003e\r\n\u003c/on-error-propagate\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003cee:transform doc:name\u003d\"Set Ignored Response\" doc:id\u003d\"63275fff-d396-4017-a3cc-e0b1a54c3f48\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\t\"status\": \"Ignored\",\n\t\"reason_code\": if (isEmpty(vars.provider)) \"NOT_A_PARTNER_ORDER\" else \"NO_WEBHOOK_URL\",\n\t\"provider\": if (isEmpty(vars.provider)) null else vars.provider,\n\t\"shipmentId\": vars.shipmentNumber\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"httpStatus\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n200]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Ignored\" doc:id\u003d\"92f3ec1a-731b-4132-87a9-26eedf933bb6\" message\u003d\"#[%dw 2.0\noutput application/json\n---\npayload]\"\u003e\u003c/logger\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"#[if (isEmpty(vars.provider)) \"not_partner\" else \"no_webhook_url\"]\" doc:name\u003d\"Outcome Ignored\" doc:id\u003d\"df6d08e1-dbc3-4728-9c0f-3799a7f17724\"\u003e\u003c/set-variable\u003e\r\n\u003cchoice doc:name\u003d\"Sweep?\" doc:id\u003d\"c102fcd8-db60-4181-a759-22403509c0d0\"\u003e\r\n\u003cwhen expression\u003d\"#[vars.labelSource \u003d\u003d \u0027sweep\u0027]\"\u003e\r\n\u003cset-variable variableName\u003d\"labelRecord\" value\u003d\"#[{\"status\": vars.labelOutcome, \"provider\": (if (isEmpty(vars.provider)) \"-\" else vars.provider), \"error\": null, \"withPayload\": false}]\" doc:name\u003d\"Ignored Record\" doc:id\u003d\"8f22e681-d4dc-433c-a163-d6ed310952c6\"\u003e\u003c/set-variable\u003e\r\n\u003cflow-ref doc:name\u003d\"label-record-flow\" doc:id\u003d\"6d4fbcbf-0e31-46d6-833c-85d71c647c83\" name\u003d\"label-record-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e\r\n\u003c/sub-flow\u003e","startColumn":2,"startLine":139},"parameters":[{"unresolvedValue":"deliver-label-flow","metadata":{"docAttributes":{"id":"6ad9a1e9-722f-4c2b-8b42-610ce8c92fa8"},"endColumn":13,"endLine":284,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":13},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":139},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":139},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":284},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":84},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":284}},"sourceCode":"\u003csub-flow name\u003d\"deliver-label-flow\" doc:id\u003d\"6ad9a1e9-722f-4c2b-8b42-610ce8c92fa8\"\u003e\r\n\u003cee:transform doc:name\u003d\"Set Partner Request\" doc:id\u003d\"6aa56fe1-7f4f-456e-8506-89b758ba55a5\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"request\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\nvar base \u003d if (isEmpty(vars.provider)) null else vars.connectionDetails[vars.provider]\n---\nif (base \u003d\u003d null) null else (vars.provider match {\n\tcase \"PMD\" -\u003e base ++ {\n\t\t\"queryParams\": {\n\t\t\t\"event\": \"shipping_label\"\n\t\t}\n\t}\n\tcase \"WLM\" -\u003e base ++ {\n\t\t\"uriParams\": {\n\t\t\t\"event\": \"shipped\"\n\t\t}\n\t}\n\telse -\u003e base\n})]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"labelSource\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nvars.labelSource default \"webhook\"]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"entity\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n\"shipment\"]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"labelBody\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n---\nwrite(payload, \"application/json\", {indent: false})]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cchoice doc:name\u003d\"Partner Webhook?\" doc:id\u003d\"27d51062-3cce-4331-922d-42fc9f47f67f\"\u003e\r\n\u003cwhen expression\u003d\"#[vars.request !\u003d null and !isEmpty(vars.request.url)]\"\u003e\r\n\u003cchoice doc:name\u003d\"Dry Run?\" doc:id\u003d\"009c5bf8-66a8-400e-8212-536491b72367\"\u003e\r\n\u003cwhen expression\u003d\"#[vars.labelSource \u003d\u003d \u0027sweep\u0027 and (vars.labelDryRun default false)]\"\u003e\r\n\u003cset-variable variableName\u003d\"labelRecord\" value\u003d\"#[{\"status\": \"dry_run\", \"provider\": vars.provider, \"error\": null, \"withPayload\": true}]\" doc:name\u003d\"Dry Run Record\" doc:id\u003d\"c33d1425-4e3d-40da-873f-806363404f4c\"\u003e\u003c/set-variable\u003e\r\n\u003cflow-ref doc:name\u003d\"label-record-flow\" doc:id\u003d\"d364c5cf-46e2-43b0-8633-5b3a2eee0d9a\" name\u003d\"label-record-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Dry Run\" doc:id\u003d\"73974a6c-a45e-4fbc-bc88-845a4a7c2571\" message\u003d\"#[output application/json --- {\"Event\": \"LABEL SWEEP DRY RUN\", \"messages\": \"Would send this shipping label to the partner (dry run: nothing sent)\", \"provider\": vars.provider, \"shipment_id\": vars.shipmentNumber}]\"\u003e\u003c/logger\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"dry_run\" doc:name\u003d\"Outcome Dry Run\" doc:id\u003d\"635e57c3-0d4b-4a21-bbf7-c232fd28eb98\"\u003e\u003c/set-variable\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003cflow-ref doc:name\u003d\"label-claim-flow\" doc:id\u003d\"5f347c21-b0d8-4950-ac9c-420424f731ee\" name\u003d\"label-claim-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cchoice doc:name\u003d\"Claimed?\" doc:id\u003d\"5b9b4d8e-9e2a-4bc6-a845-d9a57a400483\"\u003e\r\n\u003cwhen expression\u003d\"#[!(vars.labelClaimed default true)]\"\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Already Delivered\" doc:id\u003d\"9fab1c28-40b3-49bf-ab6e-83990e64a533\" message\u003d\"#[output application/json --- {\"messages\": \"Shipping label already delivered to this partner (or being sent); not sent again\", \"provider\": vars.provider, \"shipment_id\": vars.shipmentNumber, \"source\": vars.labelSource}]\"\u003e\u003c/logger\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"already\" doc:name\u003d\"Outcome Already\" doc:id\u003d\"fa8f4c83-0638-486b-ba57-4ed02d3e5525\"\u003e\u003c/set-variable\u003e\r\n\u003cee:transform doc:name\u003d\"Set Already Delivered Response\" doc:id\u003d\"62920304-0177-43fe-bc2d-f00f09e86044\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\t\"status\": \"AlreadyDelivered\",\n\t\"provider\": vars.provider,\n\t\"shipmentId\": vars.shipmentNumber\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"httpStatus\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n200]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Provider Information\" doc:id\u003d\"c960a0ba-99c9-4978-bb50-4fe183470bb6\" message\u003d\"#[%dw 2.0\noutput application/json\n---\n{\n \"messages\" : \"Posting shipment information to provider\",\n \"provider\":  vars.provider,\n \"shipment_id\": vars.shipmentNumber,\n \"source\": vars.labelSource\n}]\"\u003e\u003c/logger\u003e\r\n\u003ctry doc:name\u003d\"Send Label\" doc:id\u003d\"b4789524-fc30-4325-a072-70799a43f71f\"\u003e\r\n\u003cset-variable variableName\u003d\"haltFlow\" value\u003d\"#[false]\" doc:name\u003d\"Reset Halt Flag\" doc:id\u003d\"574da05f-a8d2-4001-9ab4-4ee068a2f989\"\u003e\u003c/set-variable\u003e\r\n\u003cflow-ref doc:name\u003d\"common-request-flow\" doc:id\u003d\"2944e15e-08d3-4b6d-9e98-01c6bf380e19\" name\u003d\"common-request-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cset-variable variableName\u003d\"labelRecord\" value\u003d\"#[{\"status\": \"sent\", \"httpStatus\": attributes.statusCode default null, \"error\": null}]\" doc:name\u003d\"Sent Record\" doc:id\u003d\"f23a24b5-9fe1-4c59-ac33-ff16f4906920\"\u003e\u003c/set-variable\u003e\r\n\u003cflow-ref doc:name\u003d\"label-mark-flow\" doc:id\u003d\"a46d4521-c95a-48f5-84bc-398e3f7a8a0f\" name\u003d\"label-mark-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"sent\" doc:name\u003d\"Outcome Sent\" doc:id\u003d\"b3bb13ab-fbde-4bd8-b693-2975df6170d0\"\u003e\u003c/set-variable\u003e\r\n\u003cset-payload value\u003d\"#[%dw 2.0\noutput application/json\n---\npayload]\" doc:name\u003d\"Set Shipment Output Response\" doc:id\u003d\"b5dc2139-5da7-4c4e-a21c-bd07360fe0a6\"\u003e\u003c/set-payload\u003e\r\n\u003cerror-handler\u003e\r\n\u003con-error-propagate enableNotifications\u003d\"true\" logException\u003d\"true\" doc:name\u003d\"Record Failure\" doc:id\u003d\"89480c19-02e3-4f47-b079-202cac0ebf05\"\u003e\r\n\u003cee:transform doc:name\u003d\"Failure Record\" doc:id\u003d\"eb2546e5-c571-4f7e-bfaf-23d20d50a2d2\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"labelRecord\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\nvar halted \u003d (error.errorType.identifier default \"\") \u003d\u003d \"HALT_FLOW\"\nvar partnerMessage \u003d vars.error.errorMessage\nvar partnerText \u003d if (partnerMessage is String) partnerMessage\n\telse if ((partnerMessage is Object) or (partnerMessage is Array)) write(partnerMessage, \"application/json\", {indent: false})\n\telse \"\"\nvar detail \u003d if (halted) ((vars.error.errorType default \"\") ++ \" \" ++ partnerText)\n\telse ((error.errorType.namespace default \"\") ++ \":\" ++ (error.errorType.identifier default \"\"))\n---\n{\n\t\"status\": if (halted) \"rejected\" else \"failed\",\n\t\"httpStatus\": null,\n\t\"error\": if (sizeOf(detail) \u003e 300) detail[0 to 299] else detail\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003cflow-ref doc:name\u003d\"label-mark-flow\" doc:id\u003d\"5f66ff0e-c3d0-4d47-b243-2c67725118c2\" name\u003d\"label-mark-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"#[vars.labelRecord.status]\" doc:name\u003d\"Outcome Failed\" doc:id\u003d\"9948b569-be4c-4eb4-9530-3a718049f139\"\u003e\u003c/set-variable\u003e\r\n\u003c/on-error-propagate\u003e\r\n\u003c/error-handler\u003e\r\n\u003c/try\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e\r\n\u003c/when\u003e\r\n\u003cotherwise\u003e\r\n\u003cee:transform doc:name\u003d\"Set Ignored Response\" doc:id\u003d\"63275fff-d396-4017-a3cc-e0b1a54c3f48\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\t\"status\": \"Ignored\",\n\t\"reason_code\": if (isEmpty(vars.provider)) \"NOT_A_PARTNER_ORDER\" else \"NO_WEBHOOK_URL\",\n\t\"provider\": if (isEmpty(vars.provider)) null else vars.provider,\n\t\"shipmentId\": vars.shipmentNumber\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"httpStatus\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n200]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Log Ignored\" doc:id\u003d\"92f3ec1a-731b-4132-87a9-26eedf933bb6\" message\u003d\"#[%dw 2.0\noutput application/json\n---\npayload]\"\u003e\u003c/logger\u003e\r\n\u003cset-variable variableName\u003d\"labelOutcome\" value\u003d\"#[if (isEmpty(vars.provider)) \"not_partner\" else \"no_webhook_url\"]\" doc:name\u003d\"Outcome Ignored\" doc:id\u003d\"df6d08e1-dbc3-4728-9c0f-3799a7f17724\"\u003e\u003c/set-variable\u003e\r\n\u003cchoice doc:name\u003d\"Sweep?\" doc:id\u003d\"c102fcd8-db60-4181-a759-22403509c0d0\"\u003e\r\n\u003cwhen expression\u003d\"#[vars.labelSource \u003d\u003d \u0027sweep\u0027]\"\u003e\r\n\u003cset-variable variableName\u003d\"labelRecord\" value\u003d\"#[{\"status\": vars.labelOutcome, \"provider\": (if (isEmpty(vars.provider)) \"-\" else vars.provider), \"error\": null, \"withPayload\": false}]\" doc:name\u003d\"Ignored Record\" doc:id\u003d\"8f22e681-d4dc-433c-a163-d6ed310952c6\"\u003e\u003c/set-variable\u003e\r\n\u003cflow-ref doc:name\u003d\"label-record-flow\" doc:id\u003d\"6d4fbcbf-0e31-46d6-833c-85d71c647c83\" name\u003d\"label-record-flow\"\u003e\u003c/flow-ref\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e\r\n\u003c/otherwise\u003e\r\n\u003c/choice\u003e\r\n\u003c/sub-flow\u003e","startColumn":2,"startLine":139},"groupModelName":"General","modelName":"name","value":{"aString":"deliver-label-flow"},"defaultValue":false}],"componentId":"deliver-label-flow","extensionModel":{"name":"mule"},"modelName":"subFlow","modelType":"CONSTRUCT","annotations":{"{http://www.mulesoft.org/schema/mule/documentation}id":"6ad9a1e9-722f-4c2b-8b42-610ce8c92fa8"}},{"directChildren":[{"directChildren":[{"directChildren":[],"componentType":"OPERATION","identifier":{"name":"insert","namespace":"db","namespaceUri":"http://www.mulesoft.org/schema/mule/db"},"location":{"name":"label-claim-flow","parts":[{"partPath":"label-claim-flow","partIdentifier":{"identifier":{"name":"sub-flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"SUB_FLOW"}},"fileName":"implementation/shipment.xml","line":287,"column":2},{"partPath":"processors"},{"partPath":"0","partIdentifier":{"identifier":{"name":"try","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"SCOPE"}},"fileName":"implementation/shipment.xml","line":288,"column":3},{"partPath":"processors"},{"partPath":"0","partIdentifier":{"identifier":{"name":"insert","namespace":"db","namespaceUri":"http://www.mulesoft.org/schema/mule/db"},"type":{"name":"OPERATION"}},"fileName":"implementation/shipment.xml","line":289,"column":4}],"location":"label-claim-flow/processors/0/processors/0"},"metadata":{"docAttributes":{"name":"Claim Label","id":"ac4d32dd-8d17-423b-9d91-01d846a2ab83"},"endColumn":16,"endLine":300,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"