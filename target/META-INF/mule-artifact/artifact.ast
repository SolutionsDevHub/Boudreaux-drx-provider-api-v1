/www.mulesoft.org/schema/mule/documentation}id":"9647ada8-5c7d-4491-82e9-25fdd1b2b27a"}},{"directChildren":[],"componentType":"OPERATION","identifier":{"name":"transform","namespace":"ee","namespaceUri":"http://www.mulesoft.org/schema/mule/ee/core"},"location":{"name":"label-report-flow","parts":[{"partPath":"label-report-flow","partIdentifier":{"identifier":{"name":"sub-flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"SUB_FLOW"}},"fileName":"implementation/shipment.xml","line":842,"column":2},{"partPath":"processors"},{"partPath":"2","partIdentifier":{"identifier":{"name":"transform","namespace":"ee","namespaceUri":"http://www.mulesoft.org/schema/mule/ee/core"},"type":{"name":"OPERATION"}},"fileName":"implementation/shipment.xml","line":849,"column":3}],"location":"label-report-flow/processors/2"},"metadata":{"docAttributes":{"name":"Report Summary","id":"107a87eb-dba1-4ef8-99ac-4aceadca65c9"},"endColumn":18,"endLine":894,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":18},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":849},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":849},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":894},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":89},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":894},"DECLARED_PREFIX":{"type":"java.lang.String","value":"ee"}},"sourceCode":"\u003cee:transform doc:name\u003d\"Report Summary\" doc:id\u003d\"107a87eb-dba1-4ef8-99ac-4aceadca65c9\"\u003e\r\n\u003cee:message\u003e\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"labelReport\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n// r16: partners left out of the report (PROD: BND, our test tenant, whose test labels go to the test endpoint)\nvar hide \u003d ((p(\u0027labelSweep.reportHidePartners\u0027) default \"\") splitBy \",\") map trim($) filter ($ !\u003d \"\")\nvar rows \u003d (vars.reportCounts default []) filter !(hide contains ($.provider_code as String))\nfun total(list) \u003d sum(list map (($.n default 0) as Number)) default 0\nvar codes \u003d ((rows filter ($.provider_code !\u003d \"-\")) map ($.provider_code as String)) distinctBy $ orderBy $\nvar partners \u003d codes map ((code) -\u003e do {\n\tvar mine \u003d rows filter ($.provider_code \u003d\u003d code)\n\t---\n\t{\n\t\tpartner: code,\n\t\tbyWebhook: total(mine filter (($.status \u003d\u003d \"sent\") and ($.source \u003d\u003d \"webhook\"))),\n\t\tbySweep: total(mine filter (($.status \u003d\u003d \"sent\") and ($.source !\u003d \"webhook\"))),\n\t\twouldSend: total(mine filter ($.status \u003d\u003d \"dry_run\")),\n\t\tfailing: total(mine filter ([\"failed\", \"sending\"] contains $.status)),\n\t\trejected: total(mine filter ($.status \u003d\u003d \"rejected\")),\n\t\tnoUrl: total(mine filter ($.status \u003d\u003d \"no_webhook_url\"))\n\t}\n})\n---\n{\n\tdryRun: p(\u0027labelSweep.dryRun\u0027) \u003d\u003d \u0027true\u0027,\n\tpartners: partners,\n\tbyWebhook: sum(partners map $.byWebhook) default 0,\n\tbySweep: sum(partners map $.bySweep) default 0,\n\twouldSend: sum(partners map $.wouldSend) default 0,\n\tfailing: sum(partners map $.failing) default 0,\n\trejected: sum(partners map $.rejected) default 0,\n\totherLabels: total(rows filter (($.provider_code \u003d\u003d \"-\") and ($.status \u003d\u003d \"not_partner\"))),\n\tnoFills: total(rows filter ($.status \u003d\u003d \"no_fills\")),\n\tlookupFailed: total(rows filter ($.status \u003d\u003d \"lookup_failed\")),\n\tnotDelivered: ((vars.reportOpen default []) filter !(hide contains ($.provider_code as String))) map {\n\t\tlabel: $.label_id,\n\t\tpartner: $.provider_code,\n\t\tstatus: $.status,\n\t\tattempts: $.attempts,\n\t\tsince: $.created_epoch,\n\t\terror: $.last_error\n\t}\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e","startColumn":3,"startLine":849},"parameters":[{"groupModelName":"Message","modelName":"setPayload","value":{},"defaultValue":true},{"groupModelName":"Message","modelName":"setAttributes","value":{},"defaultValue":true},{"metadata":{"docAttributes":{},"endColumn":19,"endLine":893,"fileName":"implementation/shipment.xml","fileUri":"file:/D:/Boud/drx-provider-api-v1/src/main/mule/implementation/shipment.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":4},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":19},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":851},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":851},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":893},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":4},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":18},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":893},"DECLARED_PREFIX":{"type":"java.lang.String","value":"ee"}},"sourceCode":"\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"labelReport\"\u003e\u003c![CDATA[%dw 2.0\noutput application/java\n// r16: partners left out of the report (PROD: BND, our test tenant, whose test labels go to the test endpoint)\nvar hide \u003d ((p(\u0027labelSweep.reportHidePartners\u0027) default \"\") splitBy \",\") map trim($) filter ($ !\u003d \"\")\nvar rows \u003d (vars.reportCounts default []) filter !(hide contains ($.provider_code as String))\nfun total(list) \u003d sum(list map (($.n default 0) as Number)) default 0\nvar codes \u003d ((rows filter ($.provider_code !\u003d \"-\")) map ($.provider_code as String)) distinctBy $ orderBy $\nvar partners \u003d codes map ((code) -\u003e do {\n\tvar mine \u003d rows filter ($.provider_code \u003d\u003d code)\n\t---\n\t{\n\t\tpartner: code,\n\t\tbyWebhook: total(mine filter (($.status \u003d\u003d \"sent\") and ($.source \u003d\u003d \"webhook\"))),\n\t\tbySweep: total(mine filter (($.status \u003d\u003d \"sent\") and ($.source !\u003d \"webhook\"))),\n\t\twouldSend: total(mine filter ($.status \u003d\u003d \"dry_run\")),\n\t\tfailing: total(mine filter ([\"failed\", \"sending\"] contains $.status)),\n\t\trejected: total(mine filter ($.status \u003d\u003d \"rejected\")),\n\t\tnoUrl: total(mine filter ($.status \u003d\u003d \"no_webhook_url\"))\n\t}\n})\n---\n{\n\tdryRun: p(\u0027labelSweep.dryRun\u0027) \u003d\u003d \u0027true\u0027,\n\tpartners: partners,\n\tbyWebhook: sum(partners map $.byWebhook) default 0,\n\tbySweep: sum(partners map $.bySweep) default 0,\n\twouldSend: sum(partners map $.wouldSend) default 0,\n\tfailing: sum(partners map $.failing) default 0,\n\trejected: sum(partners map $.rejected) default 0,\n\totherLabels: total(rows filter (($.provider_code \u003d\u003d \"-\") and ($.status \u003d\u003d \"not_partner\"))),\n\tnoFills: total(rows filter ($.status \u003d\u003d \"no_fills\")),\n\tlookupFailed: total(rows filter ($.status \u003d\u003d \"lookup_failed\")),\n\tnotDelivered: ((vars.reportOpen default []) filter !(hide contains ($.provider_code as String))) map {\n\t\tlabel: $.label_id,\n\t\tpartner: $.provider_code,\n\t\tstatus: $.status,\n\t\tattempts: $.attempts,\n\t\tsince: $.created_epoch,\n\t\terror: $.last_error\n\t}\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e","startColumn":4,"startLine":851},"groupModelName":"Set Variables","modelName":"variables","value":{"listOfPojoComponentAstDto":[{"directChildren":[],"componentType":"UNKNOWN","identifier":{"name":"set-variable","namespace":"ee","namespaceUri":"http://www.mulesoft.org/schema/mule/ee/core"},"location":{"name":"label-report-flow","parts":[{"partPath"