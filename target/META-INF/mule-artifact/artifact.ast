et-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\nif ( !isEmpty(vars.error) ) vars.error else \n\n{\n\t\"errorMessage\": error.errorMessage.payload.message default error.detailedDescription,\n\t\"errorType\": (error.errorType.namespace default \u0027\u0027) ++ \":\" ++ (error.errorType.identifier default \u0027\u0027),\n\t\"correlationId\": vars.correlationId,\n\t\"applicationName\": vars.flowName,\n\t\"time\": now()\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003c/ee:transform\u003e\r\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Logger\" doc:id\u003d\"ee4bc337-f89e-459a-99de-702d70d68c72\" message\u003d\"#[%dw 2.0\noutput application/json\n---\npayload]\"\u003e\u003c/logger\u003e\r\n\u003c/on-error-propagate\u003e\r\n\u003con-error-continue enableNotifications\u003d\"true\" logException\u003d\"true\" doc:name\u003d\"On Error Continue\" doc:id\u003d\"388e6c69-6637-4353-9465-8cac662a9b58\"\u003e\r\n\u003canypoint-mq:publish doc:name\u003d\"Publish\" doc:id\u003d\"3e9f3cc7-19e2-4131-948a-1f6fa3b8b7fe\" config-ref\u003d\"Anypoint_MQ_Config\" destination\u003d\"${anypoint.mq.retryQueue}\" deliveryDelay\u003d\"${anypoint.mq.deliveryDelay}\" deliveryDelayUnit\u003d\"MINUTES\"\u003e\r\n\u003canypoint-mq:body\u003e\u003c![CDATA[#[vars.actualRequest]]]\u003e\u003c/anypoint-mq:body\u003e\r\n\u003c/anypoint-mq:publish\u003e\r\n\u003cee:transform doc:name\u003d\"Create Error Payload\" doc:id\u003d\"7d1a3204-cf34-46c1-a333-a1e5dc76d5c0\"\u003e\r\n\u003cee:message\u003e\r\n\u003cee:set-payload\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\tmessage: \"Accepted\"\n}]]\u003e\u003c/ee:set-payload\u003e\r\n\u003c/ee:message\u003e\r\n\u003cee:variables\u003e\r\n\u003cee:set-variable variableName\u003d\"httpStatus\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n202]]\u003e\u003c/ee:set-variable\u003e\r\n\u003cee:set-variable variableName\u003d\"email\"\u003e\u003c![CDATA[%dw 2.0\noutput application/json\n---\n{\n\tmessage: {\n\t\tsubject: \"RX Processing Failed After Maximum Retries\",\n\t\tbody: {\n\t\t\tcontentType: \"HTML\",\n\t\t\tcontent: \"\u003chtml\u003e\u003cbody\u003e\" ++\n        \"\u003cp\u003eHi Team,\u003c/p\u003e\" ++\n        \"\u003cp\u003eThe RX record processing has failed after exceeding the configured retry limit due to a connection issue.\u003c/p\u003e\" ++\n        \"\u003cp\u003e\u003cstrong\u003eProcessing Details:\u003c/strong\u003e\u003c/p\u003e\" ++\n        \"\u003cul\u003e\" ++\n          \"\u003cli\u003e\u003cstrong\u003eProcess:\u003c/strong\u003e RX Record Processing\u003c/li\u003e\" ++\n          \"\u003cli\u003e\u003cstrong\u003eStatus:\u003c/strong\u003e Failed after maximum retry attempts\u003c/li\u003e\" ++\n          \"\u003cli\u003e\u003cstrong\u003eReason:\u003c/strong\u003e Connection issue\u003c/li\u003e\" ++\n          \"\u003cli\u003e\u003cstrong\u003eRetry Status:\u003c/strong\u003e Maximum retries exhausted\u003c/li\u003e\" ++\n          \"\u003cli\u003e\u003cstrong\u003eMQ Status:\u003c/strong\u003e Message successfully published to MQ for reprocessing\u003c/li\u003e\" ++\n        \"\u003c/ul\u003e\" ++\n        \"\u003cp\u003eThe message has been successfully published to MQ and will be available for subsequent processing.\u003c/p\u003e\" ++\n        \"\u003cp\u003ePlease investigate the underlying connection issue.\u003c/p\u003e\" ++\n        \"\u003cp\u003eThanks.\u003c/p\u003e\" ++\n        \"\u003c/body\u003e\u003c/html\u003e\"\n\t\t},\n\t\ttoRecipients: [{\n\t\t\temailAddress: {\n\t\t\t\taddress: p(\u0027outlook.toRecipients\u0027)\n\t\t\t}\n\t\t}]\n\t},\n\tsaveToSentItems: true\n}]]\u003e\u003c/ee:set-variable\u003e\r\n\u003c/ee:variables\u003e\r\n\u003c/ee:transform\u003e\r\n\u003c/on-error-continue\u003e\r\n\u003c/error-handler\u003e","startColumn":2,"startLine":53},"parameters":[{"unresolvedValue":"global-error-handler","groupModelName":"General","modelName":"name","value":{"aString":"global-error-handler"},"defa