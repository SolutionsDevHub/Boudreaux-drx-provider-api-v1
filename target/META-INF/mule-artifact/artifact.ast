 High Water\" doc:id\u003d\"114ed507-f108-4179-9044-e92b11f0150d\" config-ref\u003d\"Database_Config\" target\u003d\"stateResult\"\u003e\r\n\u003cdb:sql\u003e\u003c![CDATA[${db.labelStateSet}]]\u003e\u003c/db:sql\u003e\r\n\u003cdb:input-parameters\u003e\u003c![CDATA[#[{\"name\": \"high_water_label_id\", \"value\": vars.candidateInfo.highWater as String}]]]\u003e\u003c/db:input-parameters\u003e\r\n\u003c/db:insert\u003e\r\n\u003c/when\u003e\r\n\u003c/choice\u003e","startColumn":5,"startLine":726},"parameters":[{"groupModelName":"Business Events","modelName":"enableDefaultEvents","value":{"aBoolean":false},"defaultValue":true},{"groupModelName":"Output","modelName":"target","value":{},"defaultValue":true},{"groupModelName":"Output","modelName":"targetValue","value":{"expression":"payload"},"defaultValue":true},{"groupModelName":"Error Mappings","modelName":"errorMappings","value":{},"defaultValue":true}],"extensionModel":{"name":"mule"},"modelName":"choice","modelType":"OPERATION","annotations":{"{http://www.mulesoft.org/schema/mule/documentation}name":"High Water Moved?","{http://www.mulesoft.org/schema/mule/documentation}id":"d026af65-91d7-4279-a95f-9bddf2d7a22c"}},{"directChildren":[],"componentType":"OPERATION","identifier":{"name":"logger","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"location":{"name":"label-sweep-run-flow","parts":[{"partPath":"label-sweep-run-flow","partIdentifier":{"identifier":{"name":"sub-flow","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"SUB_FLOW"}},"fileName":"implementation/shipment.xml","line":380,"column":2},{"partPath":"processors"},{"partPath":"5","partIdentifier":{"identifier":{"name":"choice","namespace":"mule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"ROUTER"}},"fileName":"implementation/shipment.xml","line":492,"column":3},{"partPath":"route"},{"partPath":"0","partIdentifier":{"identifier":{"name":"when","namespace":